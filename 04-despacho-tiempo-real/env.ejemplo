# Copiar este archivo como ".env" y completar lo que corresponda.
# NUNCA subir .env a git (está en .gitignore). Las variables definidas en el entorno del
# proceso tienen prioridad sobre este archivo. Todos los valores son marcadores de ejemplo.

# ---- Modo de datos: auto | demo | sql -------------------------------------------------------
# auto: usa la base de datos si hay credenciales completas; si no, el simulador.
DATA_SOURCE=auto

# ---- Servidor web ----------------------------------------------------------------------------
WEB_HOST=127.0.0.1
# Escuchar en 0.0.0.0 (otro equipo en la red) exige definir WEB_TOKEN.
WEB_PORT=8080
WEB_TOKEN=

# ---- Base de despacho --------------------------------------------------------------------------
DESPACHO_SERVER=servidor-demo
DESPACHO_DATABASE=despacho_demo
# sql | windows (autenticación integrada: no requiere usuario ni clave)
DESPACHO_AUTH=sql
DESPACHO_USER=
DESPACHO_PASSWORD=

# ---- Base de planta (planes de la flota auxiliar) -----------------------------------------------
PLANTA_SERVER=servidor-demo
PLANTA_DATABASE=planta_demo
PLANTA_AUTH=sql
PLANTA_USER=
PLANTA_PASSWORD=

# ---- Opciones de conexión ------------------------------------------------------------------------
# Por defecto la conexión va cifrada y valida el certificado.
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
SQL_TIMEOUT_S=30

# ---- Zona horaria de la faena -----------------------------------------------------------------------
# Nombre IANA (p. ej. America/New_York). Si el sistema no tiene base de zonas, se usa el desfase fijo.
ZONA_HORARIA=UTC
ZONA_DESFASE_RESPALDO_H=0

# ---- Panel de recomendaciones (previsto) ---------------------------------------------------------------
# reglas (local, sin red, por defecto) | externo (proveedor de IA opcional)
IA_PROVEEDOR=reglas
IA_API_KEY=

# ---- Simulador (modo demo, previsto) -------------------------------------------------------------------
# ver config/escenarios/
DEMO_ESCENARIO=turno_normal
DEMO_SEMILLA=42
# 1 = tiempo real; 60 = un minuto virtual por segundo real
DEMO_FACTOR_TIEMPO=1
# fecha-hora virtual de inicio, p. ej. 2025-03-04T15:03:00 (vacío = ahora)
DEMO_INICIO=

# ---- Registro ---------------------------------------------------------------------------------------------
LOG_NIVEL=INFO
