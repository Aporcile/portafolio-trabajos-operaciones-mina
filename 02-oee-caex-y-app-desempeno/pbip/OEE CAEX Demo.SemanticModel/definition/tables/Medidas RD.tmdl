	/// CAEX equivalentes en flota: horas nominales / (24 × días). Por día es el número de CAEX que contó la flota.
	measure 'CAEX en flota' = DIVIDE([HN real], 24 * [Días periodo])
		formatString: 0.0
		displayFolder: Detalle
		lineageTag: e05af7cd-0e48-5c7a-8392-88f256df8c15

	/// CAEX equivalentes del plan.
	measure 'CAEX en flota plan' = DIVIDE([HN plan], 24 * [Días periodo])
		formatString: 0.0
		displayFolder: Detalle
		lineageTag: f3496bba-14c9-548b-bdf4-7446442fad23

	measure 'Color flota' =
			VAR r = [CAEX en flota]
			VAR p = [CAEX en flota plan]
			RETURN
			    SWITCH(TRUE(),
			        ISBLANK(r), BLANK(),
			        ISBLANK(p) || p = 0, "#4F9DDE",
			        r >= 0.999 * p, "#2E7D32",
			        r >= 0.95 * p, "#F28C28",
			        "#C62828"
			    )
		isHidden
		displayFolder: Detalle
		lineageTag: f5957ca0-87f8-51a7-8329-34f264a52a92

	/// Días de 24 h que el CAEX contó en la flota en el periodo.
	measure 'Días en flota' = DIVIDE([HN real], 24)
		formatString: 0.0
		displayFolder: Detalle
		lineageTag: 90600108-9e4b-5eb5-91c7-23799693cc10

	/// Horas de mantención (programada, no programada, neumáticos y daño) por código.
	measure 'Horas no disponibles' =
			VAR i = [Inicio periodo]
			VAR f = [Fin periodo]
			RETURN CALCULATE(SUM(Horas_Codigo_CAEX[Horas]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], i, f)), KEEPFILTERS(Horas_Codigo_CAEX[Categoria] IN {"Mantención programada", "Mantención no programada", "Daño operacional", "Neumáticos", "Cambio programado de neumáticos"}))
		formatString: #,0.0
		displayFolder: Detalle\Códigos
		lineageTag: be88c8a4-542a-5f5b-897e-42cfeec3f540

	/// Horas del código sobre las horas nominales de la flota: los puntos de disponibilidad que se van en ese código.
	measure '% del nominal' = DIVIDE([Horas no disponibles], CALCULATE([HN real], REMOVEFILTERS(Horas_Codigo_CAEX)))
		formatString: 0.0%
		displayFolder: Detalle\Códigos
		lineageTag: 83112cf9-2bba-5f4d-bcea-9128cdf9b3f3

	/// Horas de demora programada, no programada y reserva por código.
	measure 'Horas no efectivas' =
			VAR i = [Inicio periodo]
			VAR f = [Fin periodo]
			RETURN CALCULATE(SUM(Horas_Codigo_CAEX[Horas]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], i, f)), KEEPFILTERS(Horas_Codigo_CAEX[Categoria] IN {"Demora programada", "Demora no programada", "Reserva"}))
		formatString: #,0.0
		displayFolder: Detalle\Códigos
		lineageTag: e93537b8-a9a2-594b-9628-8f2d8c3679e6

	/// Horas del código sobre las horas disponibles de la flota: los puntos de UEBD que se van en ese código.
	measure '% del disponible' = DIVIDE([Horas no efectivas], CALCULATE([HD real], REMOVEFILTERS(Horas_Codigo_CAEX)))
		formatString: 0.0%
		displayFolder: Detalle\Códigos
		lineageTag: 926905c4-4eea-59c1-8172-2920ecd80c3a

	/// Horas disponibles no efectivas de los CAEX por tipo: demoras, reserva y pérdida operacional.
	measure 'Horas tipo UEBD' =
			SWITCH(SELECTEDVALUE('Tipos UEBD'[Orden]),
			    1, CALCULATE(SUM(Fact_HorasEquipo[Horas Demora Programada]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    2, CALCULATE(SUM(Fact_HorasEquipo[Horas Demora No Programada]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    3, CALCULATE(SUM(Fact_HorasEquipo[Horas Reserva]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    4, CALCULATE(SUM(Fact_HorasEquipo[Horas PO Espera]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    5, CALCULATE(SUM(Fact_HorasEquipo[Horas PO Cola]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))))
		formatString: #,0
		displayFolder: Detalle\Códigos
		lineageTag: ad18fea4-b00c-57bd-9a3c-f32135ba245a

	/// Promedio del payload de los ciclos con carga completa (Fact_Ciclos): entre 200 y 330 t.
	measure 'Factor de carga' =
			VAR i = [Inicio periodo]
			VAR f = [Fin periodo]
			RETURN CALCULATE(CALCULATE(AVERAGE(Fact_Ciclos[payload]), Fact_Ciclos[payload] > 200, Fact_Ciclos[payload] < 330), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], i, f)))
		formatString: #,0.0
		displayFolder: Detalle\Ciclos
		lineageTag: 864a180f-0825-5069-9361-a0c93b79e2ef

	/// Plan diario del factor de carga (Plan_FactorCarga); sin plan en el periodo, el último conocido.
	measure 'Factor de carga plan' =
			VAR i = [Inicio periodo]
			VAR f = [Fin periodo]
			VAR p = CALCULATE(AVERAGE(Plan_FactorCarga[Plan]), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], i, f)))
			RETURN
			    IF(ISBLANK(f), BLANK(), COALESCE(p,
			        CALCULATE(LASTNONBLANKVALUE(Plan_FactorCarga[Fecha], AVERAGE(Plan_FactorCarga[Plan])),
			            REMOVEFILTERS(Dim_Tiempo), Plan_FactorCarga[Fecha] <= f)))
		formatString: #,0
		displayFolder: Detalle\Ciclos
		lineageTag: 3f559aa8-d4b6-5926-aea5-e608bdcba52e

	measure 'Color factor de carga' =
			VAR r = [Factor de carga]
			VAR p = [Factor de carga plan]
			RETURN
			    SWITCH(TRUE(),
			        ISBLANK(r), BLANK(),
			        ISBLANK(p) || p = 0, "#4F9DDE",
			        r >= 0.999 * p, "#2E7D32",
			        r >= 0.95 * p, "#F28C28",
			        "#C62828"
			    )
		isHidden
		displayFolder: Detalle\Ciclos
		lineageTag: 53d35a89-706d-52b2-a73d-87522b5d6887

	/// Minutos promedio por ciclo de cada componente (Fact_Ciclos, segundos / 60) en el periodo.
	measure 'Ciclo componente (min)' =
			SWITCH(SELECTEDVALUE('Componentes ciclo'[Orden]),
			    1, CALCULATE(AVERAGE(Fact_Ciclos[traveling_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    2, CALCULATE(AVERAGE(Fact_Ciclos[waiting_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    3, CALCULATE(AVERAGE(Fact_Ciclos[spotting_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    4, CALCULATE(AVERAGE(Fact_Ciclos[loading_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    5, CALCULATE(AVERAGE(Fact_Ciclos[hauling_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    6, CALCULATE(AVERAGE(Fact_Ciclos[queued_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    7, CALCULATE(AVERAGE(Fact_Ciclos[tipping_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))),
			    8, CALCULATE(AVERAGE(Fact_Ciclos[backing_time]) / 60, KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], [Inicio periodo], [Fin periodo]))))
		formatString: 0.0
		displayFolder: Detalle\Ciclos
		lineageTag: 9533fe3e-11dd-5511-9a47-a277d940b7c8

	/// Ciclos de acarreo en el periodo.
	measure Ciclos =
			VAR i = [Inicio periodo]
			VAR f = [Fin periodo]
			RETURN CALCULATE(COUNTROWS(Fact_Ciclos), KEEPFILTERS(DATESBETWEEN(Dim_Tiempo[Fecha], i, f)))
		formatString: #,0
		displayFolder: Detalle\Ciclos
		lineageTag: 1a94c8a0-6024-5133-8680-d4b5f9cd716a

	/// Día calendario de la hora de los datos cargados.
	measure 'Hoy datos' =
			VAR m = MAX(Dim_Actualizacion[Marca])
			RETURN IF(ISBLANK(m), [Fecha_Operacional_Actual], DATE(YEAR(m), MONTH(m), DAY(m)))
		formatString: dd-mm-yyyy
		isHidden
		displayFolder: Periodo
		lineageTag: 5bb6d917-07f5-57da-b3bb-ce147ee78e52

	/// Ayer: último día de los periodos (días operacionales de 08:00 a 08:00). El lunes es el domingo.
	measure 'Último día' =
			VAR h = [Hoy datos]
			RETURN IF(ISBLANK(h), BLANK(), h - 1)
		formatString: dd-mm-yyyy
		displayFolder: Periodo
		lineageTag: 2f2eb8e1-2423-5f86-a962-87407ee75af9

	/// Domingo de ese jueves a domingo, sin pasar de ayer.
	measure 'Fin JD' =
			VAR i = [Inicio JD]
			RETURN IF(ISBLANK(i), BLANK(), MIN(i + 3, [Último día]))
		formatString: dd-mm-yyyy
		displayFolder: Periodo
		lineageTag: 352708a2-0885-5ff3-8235-7d0fc76428d3

	/// Verdadero el primer lunes de cada mes: MENSUAL muestra el mes anterior completo.
	measure 'Mes anterior' =
			VAR h = [Hoy datos]
			RETURN NOT ISBLANK(h) && WEEKDAY(h, 2) = 1 && DAY(h) <= 7
		isHidden
		displayFolder: Periodo
		lineageTag: 9fd1617f-385a-5f6b-b8cd-dc5bae805351

	/// Ayer o, el primer lunes del mes, el último día del mes anterior.
	measure 'Fin mes' =
			VAR h = [Hoy datos]
			RETURN IF([Mes anterior], EOMONTH(h, -1), [Último día])
		formatString: dd-mm-yyyy
		displayFolder: Periodo
		lineageTag: f8236e2b-8045-524a-926d-b388df69124f

	column Valor
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fa58f327-466c-5644-85f7-e54d8560c526
		summarizeBy: none
		isNameInferred
		sourceColumn: [Valor]

		annotation SummarizationSetBy = Automatic

	partition 'Medidas RD' = calculated
		mode: import
		source = ROW("Valor", 0)

