/// Ciclos de acarreo (muestra de dos por camión y turno). time es el día en que empieza el turno; los tiempos están en segundos. Fuente: Fact_Ciclos.csv.
table Fact_Ciclos
	lineageTag: e308bf5d-efce-5e81-b6f4-b3de291d3aca

	column time
