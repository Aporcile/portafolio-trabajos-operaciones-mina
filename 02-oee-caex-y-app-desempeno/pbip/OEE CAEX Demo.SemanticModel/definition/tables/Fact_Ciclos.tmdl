	partition Fact_Ciclos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "Fact_Ciclos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"time", type datetime}, {"shift", type text}, {"crew", type text}, {"TruckName", type text}, {"ShovelName", type text}, {"Dump_LocationType", type text}, {"TruckOpName", type text}, {"payload", type number}, {"traveling_time", Int64.Type}, {"waiting_time", Int64.Type}, {"spotting_time", Int64.Type}, {"loading_time", Int64.Type}, {"hauling_time", Int64.Type}, {"queued_time", Int64.Type}, {"backing_time", Int64.Type}, {"tipping_time", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

