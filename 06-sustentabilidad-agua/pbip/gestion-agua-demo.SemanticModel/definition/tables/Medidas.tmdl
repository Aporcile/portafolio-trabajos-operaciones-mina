	measure 'KPI detenido 7 d Norte' = CALCULATE ( FORMAT ( [Horas detenidas 7 d recuperacion], "#,0" ) & " h·pozo detenidas en 7 d (" & FORMAT ( [% tiempo detenido 7 d], "0 %" ) & " del tiempo)", Activos[Circuito] = "Circuito Norte" )
		displayFolder: 2 Recuperación
		lineageTag: 371d28b8-0bda-4b74-8364-bf96d4b6cf1d

	measure 'KPI detenido 7 d Sur' = CALCULATE ( FORMAT ( [Horas detenidas 7 d recuperacion], "#,0" ) & " h·pozo detenidas en 7 d (" & FORMAT ( [% tiempo detenido 7 d], "0 %" ) & " del tiempo)", Activos[Circuito] = "Circuito Sur" )
		displayFolder: 2 Recuperación
