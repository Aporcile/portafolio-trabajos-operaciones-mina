	measure 'Ultima comunicacion texto' =
			VAR u = [Ultima marca comunicacion]
			RETURN
			    IF ( ISBLANK ( u ), "—", IF ( INT ( u ) = INT ( [Ahora] ), FORMAT ( u, "HH:mm" ), FORMAT ( u, "dd-mm HH:mm" ) ) )
		displayFolder: 10 Energía y reporte
		lineageTag: 9337b6a9-5e8a-4e3a-a7ce-702a1099c569

	measure 'Activos en estacion' = COUNTROWS ( Activos ) + 0
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: bc5c6adc-796d-4b6b-a2cd-a92625e399ff

	/// Primer registro detenido después del último registro en marcha (RUN o, si no hay RUN, caudal).
	measure 'Inicio detencion' =
			VAR hayRun = CALCULATE ( COUNTROWS ( Tags ), Tags[Medicion] = "RUN" ) > 0
			VAR qmin = [Caudal minimo bombeo] * 3.6
			VAR ultRun = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "RUN", Mediciones[Valor] = 1 )
			VAR ultQ = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "Caudal", Mediciones[Valor] >= qmin )
			RETURN
			    IF (
			        hayRun,
			        CALCULATE ( MIN ( Mediciones[FechaHora] ), Tags[Medicion] = "RUN", Mediciones[FechaHora] > ultRun ),
			        CALCULATE ( MIN ( Mediciones[FechaHora] ), Tags[Medicion] = "Caudal", Mediciones[FechaHora] > ultQ )
			    )
		formatString: dd-mm HH:mm
		displayFolder: 2 Recuperación
		lineageTag: 39328a47-1082-4a2a-a05d-db0b5cdcbb68

	/// 1 si todos los pozos o bombas de la estación quedaron detenidos (y sin corriente) dentro de Minutos simultaneidad corte.
	measure 'Posible corte energia' =
			VAR pozos = CALCULATETABLE ( VALUES ( Activos[ActivoID] ), KEEPFILTERS ( Activos[Tipo] IN { "Pozo recuperacion", "Bomba recuperacion" } ) )
			VAR n = COUNTROWS ( pozos )
			VAR ini = ADDCOLUMNS ( pozos, "@e", [Estado pozo cod], "@i", [Inicio detencion], "@c", [Corriente actual] )
			VAR nDet = COUNTROWS ( FILTER ( ini, [@e] = 3 ) )
			VAR iMin = MINX ( ini, [@i] )
			VAR iMax = MAXX ( ini, [@i] )
			VAR inicioVentana = CALCULATE ( MIN ( Mediciones[FechaHora] ), REMOVEFILTERS () )
			VAR corriente = SUMX ( ini, [@c] )
			RETURN
			    IF (
			        n >= 2 && nDet = n && NOT ISBLANK ( iMin ) && iMin > inicioVentana + 1 / 24
			            && ( iMax - iMin ) * 1440 <= [Minutos simultaneidad corte]
			            && ( ISBLANK ( corriente ) || corriente < 1 ),
			        1,
			        0
			    )
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: 8ad075fd-8ba9-4808-a632-c3c9cf58b627

	measure 'Estaciones con posible corte' = COUNTROWS ( FILTER ( VALUES ( Activos[Estacion] ), NOT ISBLANK ( Activos[Estacion] ) && [Posible corte energia] = 1 ) ) + 0
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: c4adddc1-5e0f-4bb3-b5da-f2ea06e6caa8

	measure 'Posible corte estacion' =
			VAR est = SELECTEDVALUE ( Activos[Estacion] )
			RETURN
			    IF ( ISBLANK ( est ), 0, CALCULATE ( [Posible corte energia], REMOVEFILTERS ( Activos ), Activos[Estacion] = est ) )
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: c2058502-46c0-4aaa-9b5c-e91140d15589

	measure 'Pozos congelados' = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo recuperacion" ), [Estado pozo cod] = 5 ) ) + 0
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: c09deca1-e574-4b88-aec3-7e20a542235a

	/// Horas que lleva detenido el pozo según el cálculo del historiador (sin el corte de la ventana de días).
	measure 'Horas detenido real' = CALCULATE ( [Valor actual], Tags[Medicion] = "Horas detenido" )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: efa3a1dd-ce22-43f1-abdb-5d3995ebf12c

	/// Duración real de la detención actual (cálculo del historiador; si no hay, la de la ventana de datos).
	measure 'Detenido hace' =
			VAR e = [Estado pozo cod]
			VAR h = [Horas detenido real]
			VAR ini = [Inicio detencion]
			VAR inicioVentana = CALCULATE ( MIN ( Mediciones[FechaHora] ), REMOVEFILTERS () )
			VAR hv = IF ( h > 0, h, IF ( NOT ISBLANK ( ini ), DATEDIFF ( ini, [Ahora], MINUTE ) / 60 ) )
			VAR pref = IF ( NOT ( h > 0 ) && NOT ISBLANK ( ini ) && ini <= inicioVentana + 1 / 24, "≥ ", "" )
			RETURN
			    IF (
			        e <> 3 || ISBLANK ( hv ),
			        BLANK (),
			        pref
			            & IF (
			                hv >= 48,
			                FORMAT ( INT ( hv / 24 ), "0" ) & " d " & FORMAT ( MOD ( INT ( hv ), 24 ), "0" ) & " h",
			                FORMAT ( INT ( hv ), "0" ) & " h " & FORMAT ( MOD ( INT ( hv * 60 ), 60 ), "00" ) & " min"
			            )
			    )
		displayFolder: 2 Recuperación
		lineageTag: f9fd898a-2f6e-4f40-b39d-b087c6675a40

	/// Horas detenidas en los últimos 7 días (muestras con RUN = 0 o caudal bajo el mínimo).
	measure 'Horas detenidas 7 d' =
			VAR t0 = [Ahora] - 7
			VAR qmin = [Caudal minimo bombeo] * 3.6
			VAR hayRun = CALCULATE ( COUNTROWS ( Tags ), Tags[Medicion] = "RUN" ) > 0
			VAR nRun = CALCULATE ( COUNTROWS ( Mediciones ), Tags[Medicion] = "RUN", Mediciones[Valor] < 0.5, Mediciones[FechaHora] > t0 )
			VAR nQ = CALCULATE ( COUNTROWS ( Mediciones ), Tags[Medicion] = "Caudal", Mediciones[Valor] < qmin, Mediciones[FechaHora] > t0 )
			RETURN
			    IF ( hayRun, nRun, nQ ) * [Horas por muestra]
		formatString: #,0
		displayFolder: 2 Recuperación
		lineageTag: f38f5a4b-b08b-464f-8ffc-ff0aadb368b7

	measure 'Horas detenidas 7 d texto' = IF ( ISBLANK ( [Horas detenidas 7 d] ), "0 h", FORMAT ( [Horas detenidas 7 d], "0" ) & " h" )
		displayFolder: 2 Recuperación
		lineageTag: 958e2ace-207a-4691-93bc-0c38977fe5ff

	measure 'Horas detenidas 7 d recuperacion' = SUMX ( CALCULATETABLE ( VALUES ( Activos[ActivoID] ), KEEPFILTERS ( Activos[Tipo] = "Pozo recuperacion" ) ), [Horas detenidas 7 d] )
		formatString: #,0
		displayFolder: 2 Recuperación
		lineageTag: 7ff8a93a-0349-42ab-a0c7-fa046aa77ab6

	measure '% tiempo detenido 7 d' = DIVIDE ( [Horas detenidas 7 d recuperacion], CALCULATE ( COUNTROWS ( Activos ), KEEPFILTERS ( Activos[Tipo] = "Pozo recuperacion" ) ) * 168 )
		formatString: 0 %
