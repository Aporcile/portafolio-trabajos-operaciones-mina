	measure 'Tranques alarma nivel alto' = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Tranque" ), [Alarma nivel alto tranque] >= 1 ) ) + 0
		formatString: 0
		displayFolder: 8 Tranques
