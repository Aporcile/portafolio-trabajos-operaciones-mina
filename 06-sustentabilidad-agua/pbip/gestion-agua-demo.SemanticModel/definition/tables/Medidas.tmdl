	/// Última muestra de medición de proceso (sin parámetros, cálculos ni baterías).
	measure 'Ultima marca comunicacion' =
			CALCULATE (
			    MAX ( Mediciones[FechaHora] ),
			    KEEPFILTERS ( Tags[Medicion] IN { "RUN", "Corriente", "Caudal", "Caudal total", "Totalizador", "Nivel pozo", "Profundidad", "pH", "CE", "Nivel estanque", "Nivel tranque", "Caudal aforador", "pH tranque", "Alarma alto nivel", "Detector fuga", "Modo auto", "Estado enlace" } )
			)
		formatString: dd-mm-yyyy HH:mm
		displayFolder: 10 Energía y reporte
		lineageTag: 1a5232e7-ea20-44d9-8e4d-819ce1f80932

	measure 'Minutos sin comunicacion' =
			VAR u = [Ultima marca comunicacion]
			RETURN
			    IF ( NOT ISBLANK ( u ), IF ( u > [Ahora], 0, DATEDIFF ( u, [Ahora], MINUTE ) ) )
		formatString: #,0
		displayFolder: 10 Energía y reporte
		lineageTag: ec1123a6-7658-4dca-8186-a91e644e03b0

	/// 1 si ninguna señal de proceso de la estación (o del activo) tiene dato reciente.
	measure 'Estacion sin comunicacion' = IF ( [Minutos sin comunicacion] > [Umbral horas sin dato] * 60, 1, 0 )
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: 73297d9d-e203-4026-bcce-f3277b36888f

	measure 'Estaciones sin comunicacion' = COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( Activos[Estacion] ), KEEPFILTERS ( NOT Activos[Tipo] IN { "Sala electrica", "Reporte externo", "Punto laboratorio" } ) ), NOT ISBLANK ( Activos[Estacion] ) && [Estacion sin comunicacion] = 1 ) ) + 0
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: 0d631330-2176-43d4-b336-d9e5752e02dc

	measure 'Estaciones sin comunicacion lista' =
			VAR t = FILTER ( CALCULATETABLE ( VALUES ( Activos[Estacion] ), KEEPFILTERS ( NOT Activos[Tipo] IN { "Sala electrica", "Reporte externo", "Punto laboratorio" } ) ), NOT ISBLANK ( Activos[Estacion] ) && [Estacion sin comunicacion] = 1 )
			VAR n = COUNTROWS ( t )
			RETURN
			    IF (
			        ISEMPTY ( t ),
			        "Todas las estaciones comunicando",
			        CONCATENATEX ( TOPN ( 4, t, Activos[Estacion], ASC ), Activos[Estacion], ", ", Activos[Estacion], ASC )
			            & IF ( n > 4, " y " & FORMAT ( n - 4, "0" ) & " más", "" )
			    )
		displayFolder: 10 Energía y reporte
		lineageTag: 93877fe8-46ff-45e3-883d-041b82f7458d

	measure 'Estado estacion cod' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Ultima marca comunicacion] ), BLANK (),
			    [Estacion sin comunicacion] = 1, 3,
			    [Posible corte energia] = 1, 2,
			    1
			)
		formatString: 0
		displayFolder: 10 Energía y reporte
		lineageTag: 7be9f5c2-e022-4591-a3ad-35ac3eea2751

	measure 'Estado estacion' = SWITCH ( [Estado estacion cod], 1, "● Comunicando", 2, "▲ Posible corte de energía", 3, "■ Sin comunicación" )
		displayFolder: 10 Energía y reporte
		lineageTag: e0bc02cb-b66e-464c-a89e-b27ee46d3926

	measure 'Color estado estacion' = SWITCH ( [Estado estacion cod], 1, "#4F9DDE", 2, "#F2A03D", 3, "#D64550" )
		displayFolder: 10 Energía y reporte
