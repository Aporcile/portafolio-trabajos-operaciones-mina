	measure 'Cupo mes pozo' = CALCULATE ( [Valor actual], Tags[Medicion] = "Cupo mes" )
		formatString: #,0
		displayFolder: 4 Agua fresca
		lineageTag: 649fed48-01f6-4511-a180-db531a05d6e9

	/// Proyección al cierre del mes frente al cupo mensual (volumen del mes + ritmo de 24 h); sin señal de volumen mensual usa el caudal actual.
	measure '% cupo pozo' =
			VAR p = [% proyeccion cupo]
			VAR qq = [Caudal pozo]
			VAR d = [Cupo mes pozo]
			VAR diasMes = DAY ( EOMONTH ( [Ahora], 0 ) )
			RETURN
			    IF ( NOT ISBLANK ( p ), p, IF ( NOT ISBLANK ( d ) && d > 0, DIVIDE ( qq * 3.6 * 24 * diasMes, d ) ) )
		formatString: 0 %
		displayFolder: 4 Agua fresca
		lineageTag: c1a0a970-1e86-4402-b7e1-d465b290d092

	measure 'Color % cupo' = SWITCH ( TRUE (), [% cupo pozo] > 1, "#D64550", [% cupo pozo] > 0.9, "#F2A03D", "#4F9DDE" )
		displayFolder: 4 Agua fresca
		lineageTag: e2a0a5f4-189c-405f-9b9e-969291cf9a6e

	measure 'Pozos sobre cupo' = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo agua fresca" ), [% cupo pozo] > 1 ) ) + 0
		formatString: 0
		displayFolder: 4 Agua fresca
		lineageTag: a476210c-5e5d-4c18-a35d-d7a3090f0923

	/// Volumen captado en el mes frente a la suma de cupos mensuales.
	measure '% mes vs cupo' =
			VAR a = [Ahora]
			VAR inicioMes = DATE ( YEAR ( a ), MONTH ( a ), 1 )
			VAR horasMes = DATEDIFF ( inicioMes, a, MINUTE ) / 60
			VAR qProm = CALCULATE ( AVERAGE ( Mediciones[Valor] ), Tags[Medicion] = "Caudal total", Mediciones[FechaHora] >= inicioMes )
			VAR cupo = CALCULATE ( [Valor actual], Tags[Medicion] = "Cupo mes", Activos[Tipo] = "Pozo agua fresca" )
			RETURN
			    DIVIDE ( qProm * horasMes, cupo )
		formatString: 0 %
		displayFolder: 4 Agua fresca
		lineageTag: a4766486-0e6d-4890-ba9c-8fc813e8ce7e

