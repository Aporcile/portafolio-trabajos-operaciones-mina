	measure 'Tasa tranque (%/h)' =
			AVERAGEX (
			    CALCULATETABLE ( VALUES ( Tags[Tag] ), Tags[Medicion] = "Nivel tranque", Tags[Principal] = "Si" ),
			    VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			    VAR v1 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t1 )
			    VAR t0 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Mediciones[FechaHora] <= t1 - 3 / 24 )
			    VAR v0 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t0 )
			    VAR horas = DATEDIFF ( t0, t1, MINUTE ) / 60
			    RETURN
			        IF ( NOT ISBLANK ( t0 ), DIVIDE ( v1 - v0, horas ) )
			)
		formatString: +0.0;-0.0;0.0
		displayFolder: 8 Tranques
		lineageTag: 330a3df6-36eb-4395-90bc-93adb3063e95

	measure 'Horas a HH tranque' =
			VAR n = [Nivel tranque]
			VAR hh = [HH tranque]
			VAR r = [Tasa tranque (%/h)]
			RETURN
			    IF ( NOT ISBLANK ( hh ) && r > 0.05 && n < hh, DIVIDE ( hh - n, r ) )
		formatString: 0.0
		displayFolder: 8 Tranques
		lineageTag: 810ce339-b507-4292-b181-7156559f92e0

	measure 'Alarma nivel alto tranque' = CALCULATE ( [Valor actual], Tags[Medicion] = "Alarma alto nivel" )
