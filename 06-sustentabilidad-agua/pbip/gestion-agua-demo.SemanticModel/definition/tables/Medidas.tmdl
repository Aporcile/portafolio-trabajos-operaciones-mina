	/// Captación total de agua fresca en L/s (la señal viene en m³/h).
	measure 'Caudal agua fresca total' = DIVIDE ( CALCULATE ( [Valor actual], Tags[Medicion] = "Caudal total" ), 3.6 )
		formatString: #,0.0
		displayFolder: 4 Agua fresca
		lineageTag: 96a043db-fa7f-42cc-bb06-457193ef8279

	measure '% cupo captacion' = DIVIDE ( [Caudal agua fresca total], [Cupo captacion] )
		formatString: 0 %
		displayFolder: 4 Agua fresca
		lineageTag: 012c9ff1-1dd1-44c6-bc6e-5448eeaa0ac9

	/// Caudal en L/s. Medido; en los pozos sin caudal instantáneo se calcula con la diferencia del totalizador (m³ por hora ÷ 3,6).
	measure 'Caudal pozo' =
			VAR directo = CALCULATE ( [Valor actual], Tags[Medicion] = "Caudal" )
			VAR desdeTot =
			    SUMX (
			        CALCULATETABLE ( VALUES ( Tags[Tag] ), Tags[Medicion] = "Totalizador" ),
			        VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			        VAR v1 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t1 )
			        VAR t0 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Mediciones[FechaHora] <= t1 - 1 / 24 )
			        VAR v0 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t0 )
			        RETURN
			            IF ( NOT ISBLANK ( t0 ), DIVIDE ( v1 - v0, DATEDIFF ( t0, t1, MINUTE ) / 60 ) )
			    )
			RETURN
			    DIVIDE ( IF ( NOT ISBLANK ( directo ), directo, desdeTot ), 3.6 )
		formatString: #,0.0
		displayFolder: 4 Agua fresca
		lineageTag: 90a85e73-38ab-4d9e-aa06-e3fd12a079ac

	measure 'Origen caudal' =
			SWITCH (
			    TRUE (),
			    CALCULATE ( COUNTROWS ( Tags ), Tags[Medicion] = "Caudal" ) > 0, "Medido",
			    CALCULATE ( COUNTROWS ( Tags ), Tags[Medicion] = "Totalizador" ) > 0, "Calculado (totalizador)",
			    "—"
			)
		displayFolder: 4 Agua fresca
		lineageTag: eda15d34-f3db-4745-bd08-f268306d9fd2

