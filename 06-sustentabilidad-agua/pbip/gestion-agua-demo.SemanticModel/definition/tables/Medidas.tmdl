	measure 'UPS texto' =
			VAR c = [UPS codigo]
			VAR s =
			    IF ( c >= 8, "Sin alimentación · ", "" )
			        & IF ( MOD ( INT ( c / 4 ), 2 ) = 1, "Falla · ", "" )
			        & IF ( MOD ( INT ( c / 2 ), 2 ) = 1, "Bypass · ", "" )
			        & IF ( MOD ( c, 2 ) = 1, "Batería · ", "" )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( c ), "—", c = 0, "Normal", LEFT ( s, LEN ( s ) - 3 ) )
		displayFolder: 10 Energía y reporte
		lineageTag: e14d7cad-8e06-49c5-8f74-5cbbfcd7febf

