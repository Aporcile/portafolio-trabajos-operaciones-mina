	measure 'Bombas tranque texto' =
			VAR run = CALCULATE ( [Valor actual], Tags[Medicion] = "RUN" )
			VAR modo = CALCULATE ( [Valor actual], Tags[Medicion] = "Modo auto" )
			RETURN
			    IF (
			        ISBLANK ( run ) && ISBLANK ( modo ),
			        "—",
			        IF ( NOT ISBLANK ( run ), "Bomba A " & IF ( run >= 1, "en marcha", "detenida" ), "" )
			            & IF ( NOT ISBLANK ( modo ), " · Bomba B " & IF ( modo >= 1, "en automático", "en manual" ), "" )
			    )
		displayFolder: 8 Tranques
		lineageTag: 0a249997-09b3-4f55-af64-cda0b26d8b6f

	/// 1 normal · 2 nivel alto (sobre HI o alarma de nivel alto) · 3 sobre HH o fuga · 4 sin dato · 5 sensor congelado.
	measure 'Estado tranque cod' =
			VAR n = [Nivel tranque]
			VAR hi = [HI tranque]
			VAR hh = [HH tranque]
			VAR mins = CALCULATE ( [Minutos sin comunicacion], KEEPFILTERS ( Tags[Medicion] = "Nivel tranque" ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( n ), BLANK (),
			        mins > [Umbral horas sin dato] * 60, 4,
			        [Nivel tranque congelado] > 0, 5,
			        [Fuga tranque] >= 1, 3,
			        NOT ISBLANK ( hh ) && n >= hh, 3,
			        ( NOT ISBLANK ( hi ) && n >= hi ) || [Alarma nivel alto tranque] >= 1, 2,
			        1
			    )
		formatString: 0
		displayFolder: 8 Tranques
		lineageTag: 7e446f22-6b54-4d7e-9d51-fee1ac225969

	measure 'Estado tranque' = SWITCH ( [Estado tranque cod], 1, "● Normal", 2, "▲ Nivel alto", 3, IF ( [Fuga tranque] >= 1, "■ Fuga detectada", "■ Sobre HH" ), 4, "◌ Sin dato", 5, "◇ Sensor congelado" )
		displayFolder: 8 Tranques
		lineageTag: 3fcb258c-ff0f-4633-ae32-cfc28380db57

	measure 'Color estado tranque' = SWITCH ( [Estado tranque cod], 1, "#4F9DDE", 2, "#F2A03D", 3, "#D64550", 4, "#A9B6C4", 5, "#F2A03D" )
		displayFolder: 8 Tranques
