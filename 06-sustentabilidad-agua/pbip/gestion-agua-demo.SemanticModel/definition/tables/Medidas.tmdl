		displayFolder: 6 Datos
		lineageTag: 653ea094-fd0e-42a6-8a83-282891937753

	/// 3 crítica · 2 alerta · 1 aviso. Si toda una estación perdió comunicación queda una sola alarma (la del primer activo).
	measure 'Alarma severidad' =
			VAR tipo = SELECTEDVALUE ( Activos[Tipo] )
			VAR est = SELECTEDVALUE ( Activos[Estacion] )
			VAR nEst = IF ( NOT ISBLANK ( est ), CALCULATE ( COUNTROWS ( Activos ), REMOVEFILTERS ( Activos ), Activos[Estacion] = est ) )
			VAR caida = IF ( nEst >= 2, CALCULATE ( [Estacion sin comunicacion], REMOVEFILTERS ( Activos ), Activos[Estacion] = est ), 0 )
			VAR esRepr = CALCULATE ( MIN ( Activos[Orden] ), REMOVEFILTERS ( Activos ), Activos[Estacion] = est ) = SELECTEDVALUE ( Activos[Orden] )
			VAR base =
			    SWITCH (
			        tipo,
			        "Pozo recuperacion", SWITCH ( [Estado pozo cod], 3, 3, 4, 3, 5, 2 ),
			        "Estanque", SWITCH ( [Estado estanque cod], 3, 3, 2, 2, 4, 3, 5, 2 ),
			        "Tranque", SWITCH ( [Estado tranque cod], 3, 3, 2, 2, 4, 2, 5, 2 ),
			        "Estacion calidad", SWITCH ( [Estado calidad cod], 2, 2, 4, 2, 5, 2 ),
			        "Pozo agua fresca", IF ( [% cupo pozo] > 1, 2, IF ( [% cupo pozo] > 0.9, 1 ) ),
			        "Piezometro", IF ( [Minutos sin comunicacion] > [Umbral horas sin dato] * 60 || [Profundidad congelada] > 0, 1 ),
			        "Pozo monitoreo", SWITCH ( [Estado aguas abajo cod], 3, 2, 2, 1, 4, 1, 5, 1 ),
			        "Sala electrica", SWITCH ( [Estado UPS cod], 3, 2, 2, 1 ),
			        BLANK ()
			    )
			RETURN
			    IF ( caida = 1, IF ( esRepr, 3, BLANK () ), base )
		formatString: 0
		displayFolder: 7 Alarmas
		lineageTag: 3b4a861e-d34a-44c8-b986-ee9c5153a216

	/// Prioridad estilo ISA-18.2 (1 = más urgente).
	measure Prio = IF ( NOT ISBLANK ( [Alarma severidad] ), 4 - [Alarma severidad] )
		formatString: 0
		displayFolder: 7 Alarmas
		lineageTag: e14e0203-db9f-4ffc-9bd1-e1bcf4ac727d

	measure 'Alarma nivel' = SWITCH ( [Alarma severidad], 3, "✖ Crítica", 2, "▲ Alerta", 1, "◆ Aviso" )
		displayFolder: 7 Alarmas
		lineageTag: a23b803e-025e-4ff1-b845-75201fdf4e9a

	measure 'Color alarma' = SWITCH ( [Alarma severidad], 3, "#D64550", 2, "#F2A03D", 1, "#9CC7EC" )
		displayFolder: 7 Alarmas
		lineageTag: 6cc0fd19-c5c4-4a40-9467-78a2300a86d6

	measure 'Alarma condicion' =
			VAR tipo = SELECTEDVALUE ( Activos[Tipo] )
			VAR est = SELECTEDVALUE ( Activos[Estacion] )
			VAR nEst = IF ( NOT ISBLANK ( est ), CALCULATE ( COUNTROWS ( Activos ), REMOVEFILTERS ( Activos ), Activos[Estacion] = est ) )
			VAR caida = IF ( nEst >= 2, CALCULATE ( [Estacion sin comunicacion], REMOVEFILTERS ( Activos ), Activos[Estacion] = est ), 0 )
			VAR ultEst = CALCULATE ( [Ultima marca comunicacion], REMOVEFILTERS ( Activos ), Activos[Estacion] = est )
			VAR hc = FORMAT ( [Horas para congelado], "0" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Alarma severidad] ), BLANK (),
			        caida = 1,
			            "Estación " & est & " sin comunicación: " & FORMAT ( nEst, "0" ) & " activos sin dato nuevo desde " & FORMAT ( ultEst, "dd-mm HH:mm" )
			                & IF ( [Posible corte estacion] = 1, " · posible corte de energía", "" ),
			        tipo = "Pozo recuperacion" && [Estado pozo cod] = 4, "Sin dato nuevo en el historiador desde " & FORMAT ( [Ultima marca comunicacion], "dd-mm HH:mm" ) & " · posible falla de comunicación",
			        tipo = "Pozo recuperacion" && [Estado pozo cod] = 5, "Caudal congelado: el mismo valor hace más de " & hc & " h (revisar instrumento o comunicación)",
			        tipo = "Pozo recuperacion",
			            "Pozo detenido (RUN = 0 o caudal bajo el mínimo) · caudal " & FORMAT ( [Caudal actual], "0.0" ) & " L/s"
			                & IF ( [Posible corte estacion] = 1, " · posible corte de energía en la estación", "" ),
			        tipo = "Estanque" && [Estado estanque cod] = 4, "Nivel sin dato nuevo en el historiador",
			        tipo = "Estanque" && [Estado estanque cod] = 5, "Sensor de nivel congelado en " & FORMAT ( [Nivel estanque], "0.0" ) & " % (mismo valor hace más de " & hc & " h)",
			        tipo = "Estanque",
			            "Nivel " & FORMAT ( [Nivel estanque], "0" ) & " % sobre "
			                & IF ( [Estado estanque cod] = 3, "HH (" & FORMAT ( [HH estanque], "0" ) & " %)", "HI (" & FORMAT ( [HI estanque], "0" ) & " %)" )
			                & " · tendencia " & FORMAT ( [Tasa estanque (%/h)], "+0.0;-0.0;0.0" ) & " %/h · " & [Rebalse texto],
			        tipo = "Tranque" && [Estado tranque cod] = 4, "Nivel del tranque sin dato nuevo",
			        tipo = "Tranque" && [Estado tranque cod] = 5, "Sensor de nivel congelado en " & [Nivel tranque texto] & " (mismo valor hace más de " & hc & " h)",
			        tipo = "Tranque" && [Fuga tranque] >= 1, "Detector de fuga activo · nivel " & [Nivel tranque texto],
			        tipo = "Tranque", "Nivel " & [Nivel tranque texto] & IF ( [Alarma nivel alto tranque] >= 1, " · alarma de nivel alto", "" ) & " · " & [Rebalse texto],
			        tipo = "Estacion calidad" && [Estado calidad cod] = 4, "Sin dato nuevo de pH/CE",
			        tipo = "Estacion calidad" && [Estado calidad cod] = 5, "pH congelado en " & FORMAT ( [pH actual], "0.00" ) & " (mismo valor hace más de " & hc & " h)",
			        tipo = "Estacion calidad", "pH " & FORMAT ( [pH actual], "0.0" ) & " · turbidez " & FORMAT ( [Turbidez actual], "0.0" ) & " NTU · fuera de la banda " & FORMAT ( [pH minimo], "0.0" ) & "–" & FORMAT ( [pH maximo], "0.0" ) & " (límite de ejemplo)",
			        tipo = "Pozo agua fresca",
			            "Proyección al cierre del mes: " & FORMAT ( [% cupo pozo], "0 %" ) & " del cupo mensual"
			                & IF ( NOT ISBLANK ( [Proyeccion mes (m3)] ), " (" & FORMAT ( [Proyeccion mes (m3)], "#,0" ) & " de " & FORMAT ( [Cupo mes pozo], "#,0" ) & " m³)", "" ),
			        tipo = "Piezometro",
			            IF ( [Profundidad congelada] > 0, "Profundidad congelada (mismo valor hace más de " & hc & " h)", "Estación sin dato nuevo desde " & FORMAT ( [Ultima marca comunicacion], "dd-mm HH:mm" ) ),
			        tipo = "Pozo monitoreo" && [Estado aguas abajo cod] = 4, "Pozo de monitoreo sin dato nuevo",
			        tipo = "Pozo monitoreo" && [Estado aguas abajo cod] = 5, "Profundidad congelada (mismo valor hace más de " & hc & " h)",
			        tipo = "Pozo monitoreo",
			            "Nivel freático sube " & FORMAT ( [Ascenso 7 d (m)], "0.00" ) & " m en 7 días · circuito asociado: " & SELECTEDVALUE ( Activos[CircuitoAsociado] ),
			        tipo = "Sala electrica", "UPS: " & [UPS texto],
			        BLANK ()
			    )
		displayFolder: 7 Alarmas
		lineageTag: 73cca27f-762f-431b-a568-37ee5b7c0d1c

	measure 'Alarma desde' =
			VAR tipo = SELECTEDVALUE ( Activos[Tipo] )
			VAR est = SELECTEDVALUE ( Activos[Estacion] )
			VAR nEst = IF ( NOT ISBLANK ( est ), CALCULATE ( COUNTROWS ( Activos ), REMOVEFILTERS ( Activos ), Activos[Estacion] = est ) )
			VAR caida = IF ( nEst >= 2, CALCULATE ( [Estacion sin comunicacion], REMOVEFILTERS ( Activos ), Activos[Estacion] = est ), 0 )
			VAR hi = [HI estanque]
			VAR pmin = [pH minimo]
			VAR pmax = [pH maximo]
			VAR ultBajo = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "Nivel estanque", Tags[Principal] = "Si", Mediciones[Valor] < hi )
			VAR cruceEstanque = CALCULATE ( MIN ( Mediciones[FechaHora] ), Tags[Medicion] = "Nivel estanque", Tags[Principal] = "Si", Mediciones[FechaHora] > ultBajo )
			VAR hiP = [HI tranque]
			VAR ultBajoP = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "Nivel tranque", Tags[Principal] = "Si", Mediciones[Valor] < hiP )
			VAR cruceTranque = CALCULATE ( MIN ( Mediciones[FechaHora] ), Tags[Medicion] = "Nivel tranque", Tags[Principal] = "Si", Mediciones[FechaHora] > ultBajoP )
			VAR ultOk = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "pH", Mediciones[Valor] >= pmin, Mediciones[Valor] <= pmax )
			VAR crucePH = CALCULATE ( MIN ( Mediciones[FechaHora] ), Tags[Medicion] = "pH", Mediciones[FechaHora] > ultOk )
			VAR hDet = [Horas detenido real]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Alarma severidad] ), BLANK (),
			        caida = 1, CALCULATE ( [Ultima marca comunicacion], REMOVEFILTERS ( Activos ), Activos[Estacion] = est ),
			        tipo = "Pozo recuperacion" && [Estado pozo cod] = 4, [Ultima marca comunicacion],
			        tipo = "Pozo recuperacion" && [Estado pozo cod] = 5, BLANK (),
			        tipo = "Pozo recuperacion" && hDet > 0, [Ahora] - hDet / 24,
			        tipo = "Pozo recuperacion", [Inicio detencion],
			        tipo = "Estanque", cruceEstanque,
			        tipo = "Tranque" && NOT ISBLANK ( hiP ), cruceTranque,
			        tipo = "Estacion calidad", crucePH,
			        tipo IN { "Piezometro", "Pozo monitoreo" } && [Minutos sin comunicacion] > [Umbral horas sin dato] * 60, [Ultima marca comunicacion],
			        BLANK ()
			    )
		formatString: dd-mm HH:mm
		displayFolder: 7 Alarmas
		lineageTag: 3a4c39f0-3aa9-4cc0-b5e2-086b010f57f9

	measure 'Alarma desde texto' =
			VAR d = [Alarma desde]
			RETURN
			    IF ( ISBLANK ( d ), "—", IF ( INT ( d ) = INT ( [Ahora] ), FORMAT ( d, "HH:mm" ), FORMAT ( d, "dd-mm HH:mm" ) ) )
