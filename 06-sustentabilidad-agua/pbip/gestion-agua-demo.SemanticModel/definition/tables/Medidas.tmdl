	measure 'Alarmas nivel alto tranques texto' =
			VAR t = FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Tranque" ), [Alarma nivel alto tranque] >= 1 )
			RETURN
			    IF ( ISEMPTY ( t ), "Sin alarmas de nivel alto en tranques y pozas", "Alarma de nivel alto en " & CONCATENATEX ( t, Activos[Activo], ", " ) )
		displayFolder: 8 Tranques
