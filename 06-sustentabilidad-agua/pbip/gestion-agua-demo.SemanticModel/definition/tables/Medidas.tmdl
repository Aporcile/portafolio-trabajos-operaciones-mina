/// Medidas del tablero.
table Medidas
	lineageTag: 726570b2-6904-4f58-b1f3-01ec4dbd5e85

	measure 'Desfase UTC' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Desfase UTC (h)" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: 55a50953-96e0-4cf8-aac9-7a9429c67806

	measure 'Umbral horas sin dato' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Horas sin dato" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: debfcc96-c9b2-458c-b963-18d6f20a06c5

	measure 'Caudal minimo bombeo' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Caudal minimo bombeo (L/s)" )
		formatString: 0.00
		displayFolder: 0 Parámetros
		lineageTag: 104b7fd0-86f2-47fa-9c07-96a5a587a344

	measure 'Cupo captacion' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Cupo captacion (L/s)" )
		formatString: #,0.0
		displayFolder: 0 Parámetros
		lineageTag: d7b2a287-da5e-4f79-9736-37d7a53db9c0

	measure 'Meta recuperacion Norte' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Meta recuperacion Norte (L/s)" )
		formatString: 0
