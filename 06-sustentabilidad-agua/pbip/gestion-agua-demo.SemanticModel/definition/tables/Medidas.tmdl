	/// 1 OK · 2 parcial · 3 sin datos · 5 sin señal.
	measure 'Estado fuente cod' =
			VAR tipo = SELECTEDVALUE ( Fuentes[Tipo] )
			VAR tot = [Tags fuente]
			VAR ok = [Tags con dato reciente]
			VAR minGlobal = CALCULATE ( [Minutos sin dato], REMOVEFILTERS ( Fuentes ), REMOVEFILTERS ( Tags ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        tipo = "Sin tag", 5,
			        tipo = "Servidor", IF ( minGlobal <= 30, 1, 3 ),
			        tot = 0, 5,
			        ok = tot, 1,
			        ok >= 0.8 * tot, 2,
			        3
			    )
		formatString: 0
		displayFolder: 6 Datos
