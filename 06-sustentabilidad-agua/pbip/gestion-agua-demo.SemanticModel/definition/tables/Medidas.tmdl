	measure 'Alarma duracion' =
			VAR d = [Alarma desde]
			VAR m = IF ( NOT ISBLANK ( d ), DATEDIFF ( d, [Ahora], MINUTE ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( m ), "—",
			        m >= 2880, FORMAT ( INT ( m / 1440 ), "0" ) & " d " & FORMAT ( INT ( MOD ( m, 1440 ) / 60 ), "0" ) & " h",
			        m >= 60, FORMAT ( INT ( m / 60 ), "0" ) & " h " & FORMAT ( MOD ( m, 60 ), "00" ) & " min",
			        FORMAT ( m, "0" ) & " min"
			    )
		displayFolder: 7 Alarmas
		lineageTag: a1355722-527b-4c0a-9376-d1ea35d32359

