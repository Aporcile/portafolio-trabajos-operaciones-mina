			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), "⚠ SIN DATOS CARGADOS",
			        h > [Horas datos atrasados], "⚠ DATOS AL " & FORMAT ( d, "dd-mm HH:mm" ) & " · SIN ACTUALIZAR HACE " & FORMAT ( INT ( h ), "0" ) & " H",
