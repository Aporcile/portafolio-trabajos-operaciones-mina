	measure 'Poza emergencia detalle' = CALCULATE ( [Bombas tranque texto] & IF ( [Fuga tranque] >= 1, " · FUGA DETECTADA", " · sin fuga" ), Activos[ActivoID] = "TRQ-EMER" )
		displayFolder: 8 Tranques
