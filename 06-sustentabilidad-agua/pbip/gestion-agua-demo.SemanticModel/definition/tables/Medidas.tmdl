	/// Volumen acumulado del mes (señal de volumen mensual).
	measure 'Volumen mes' = CALCULATE ( [Valor actual], Tags[Medicion] = "Volumen mes" )
		formatString: #,0
		displayFolder: 4 Agua fresca
		lineageTag: 2d73e929-72ed-474a-99da-8886a08700e3

	measure 'Volumen mes texto' = IF ( ISBLANK ( [Volumen mes] ), "—", FORMAT ( [Volumen mes], "#,0" ) & " m³" )
		displayFolder: 4 Agua fresca
		lineageTag: 285a7214-bce1-46a2-8805-6a591cfe10d8

	/// Volumen extraído en las últimas 24 h (o promedio del mes si el mes recién empieza).
	measure 'Ritmo diario mes (m3/d)' =
			VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "Volumen mes" )
			VAR v1 = [Volumen mes]
			VAR t0 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "Volumen mes", Mediciones[FechaHora] <= t1 - 1 )
			VAR v0 = CALCULATE ( SUM ( Mediciones[Valor] ), Tags[Medicion] = "Volumen mes", Mediciones[FechaHora] = t0 )
			VAR inicioMes = DATE ( YEAR ( t1 ), MONTH ( t1 ), 1 )
			VAR dias = DATEDIFF ( inicioMes, t1, MINUTE ) / 1440
			RETURN
			    IF (
			        ISBLANK ( t1 ),
			        BLANK (),
			        IF ( NOT ISBLANK ( t0 ) && t0 >= inicioMes && v1 >= v0, v1 - v0, DIVIDE ( v1, dias ) )
			    )
		formatString: #,0
		displayFolder: 4 Agua fresca
		lineageTag: 53e3cbe8-a945-421f-9602-a455cdb3ae0a

	/// Volumen al cierre del mes si el pozo sigue al ritmo de las últimas 24 h.
	measure 'Proyeccion mes (m3)' =
			VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "Volumen mes" )
			VAR v1 = [Volumen mes]
			VAR finMes = EOMONTH ( t1, 0 ) + 1
			VAR diasRest = DATEDIFF ( t1, finMes, MINUTE ) / 1440
			RETURN
			    IF ( NOT ISBLANK ( v1 ) && NOT ISBLANK ( t1 ), v1 + [Ritmo diario mes (m3/d)] * diasRest )
		formatString: #,0
		displayFolder: 4 Agua fresca
		lineageTag: bcffbd09-cb7f-48ef-a652-d27078ff77ac

	measure 'Proyeccion texto' =
			VAR p = [Proyeccion mes (m3)]
			RETURN
			    IF ( ISBLANK ( p ), "—", FORMAT ( p, "#,0" ) & " m³" )
		displayFolder: 4 Agua fresca
		lineageTag: 4c122a0f-4a7a-4f6b-84e0-84fb54d5a9bc

	measure '% proyeccion cupo' =
			VAR d = [Cupo mes pozo]
