	/// Nivel del sensor principal del tranque.
	measure 'Nivel tranque' = AVERAGEX ( CALCULATETABLE ( VALUES ( Tags[Tag] ), Tags[Medicion] = "Nivel tranque", Tags[Principal] = "Si" ), [Valor actual] )
