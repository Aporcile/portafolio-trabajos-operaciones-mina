		lineageTag: 3fd1694c-8140-417e-ae1f-7c176c06d8a3

	measure 'Meta recuperacion Sur' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Meta recuperacion Sur (L/s)" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: fca153f6-9ca6-44f0-8ab9-bd5693c87349

	measure 'pH minimo' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "pH minimo" )
		formatString: 0.0
		displayFolder: 0 Parámetros
		lineageTag: 3a3e359d-f24e-4ceb-a823-4e0680f3fb91

	measure 'pH maximo' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "pH maximo" )
		formatString: 0.0
		displayFolder: 0 Parámetros
		lineageTag: 6efb2508-cca3-4926-b9bc-0b932ebbd1af

	measure 'HI por defecto' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "HI por defecto (%)" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: bb5dc7f2-ebe0-4986-854e-eba37607fe38

	measure 'HH por defecto' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "HH por defecto (%)" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: b7b3d644-1746-4a9a-8121-b9ae3c9c6f6d

	measure 'Descenso piezometro fuerte' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Descenso piezometro fuerte (m)" )
		formatString: 0.00
		displayFolder: 0 Parámetros
		lineageTag: c5726060-18d3-4c57-9b0e-817f4540a0b5

	measure 'Descenso piezometro leve' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Descenso piezometro leve (m)" )
		formatString: 0.00
		displayFolder: 0 Parámetros
		lineageTag: d5c3c5ac-0e0a-4ba1-b86a-b1d87ec864a7

	measure 'Modo historiador' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Modo historiador" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: e071ec6d-660d-4264-8311-4f14d7043a0f

	/// Reloj del modelo: hora actual con el historiador; hora de referencia de los datos con el CSV sintético.
	measure Ahora = IF ( [Modo historiador] = 1, UTCNOW () + [Desfase UTC] / 24, MAX ( Actualizacion[HoraReferencia] ) )
		formatString: dd-mm-yyyy HH:mm
		displayFolder: 0 Parámetros
		lineageTag: 5e1b4eda-beb1-4b1e-a624-eee4ec3b4193

	measure 'Gauge minimo' = 0
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: 7c3f8a83-b9ad-468f-b2d1-995bff7251fd

	measure 'Gauge maximo' = 100
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: 56cd4aea-682a-4449-9b71-76b9aa0f9797

	/// Hora de la última muestra: por señal, la de la señal; por activo o grupo, la de sus mediciones de proceso (no cuenta cálculos, baterías ni parámetros).
	measure 'Ultima marca' =
			VAR todas = MAX ( Mediciones[FechaHora] )
			RETURN
			    IF ( HASONEVALUE ( Tags[Tag] ), todas, COALESCE ( [Ultima marca comunicacion], todas ) )
		formatString: dd-mm-yyyy HH:mm
		displayFolder: 1 Base
		lineageTag: 751cd501-92b4-4890-b9e0-363d6d77c362

	/// Último valor de cada señal del contexto, sumado.
	measure 'Valor actual' =
			SUMX (
			    VALUES ( Tags[Tag] ),
			    VAR t = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			    RETURN
			        CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t )
			)
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: 554e8d53-3d5d-42e5-8fbb-d040286a2ee3

	measure 'Minutos sin dato' =
			VAR u = [Ultima marca]
			VAR a = [Ahora]
			RETURN
			    IF ( NOT ISBLANK ( u ), IF ( u > a, 0, DATEDIFF ( u, a, MINUTE ) ) )
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: b543134a-b599-4b48-b6e5-49c5b203b265

	measure 'Ultimo dato texto' =
			VAR u = [Ultima marca]
			RETURN
			    IF (
			        ISBLANK ( u ),
			        "—",
			        IF ( INT ( u ) = INT ( [Ahora] ), FORMAT ( u, "HH:mm" ), FORMAT ( u, "dd-mm HH:mm" ) )
			    )
		displayFolder: 1 Base
		lineageTag: 8c643362-975a-46eb-bc1d-a801d263a302

	measure 'Tiempo sin dato texto' =
			VAR m = [Minutos sin dato]
			RETURN
			    IF (
			        ISBLANK ( m ),
			        BLANK (),
			        IF ( m >= 60, FORMAT ( INT ( m / 60 ), "0" ) & " h " & FORMAT ( MOD ( m, 60 ), "00" ) & " min", FORMAT ( m, "0" ) & " min" )
			    )
		displayFolder: 1 Base
		lineageTag: 3481454d-ea79-4f33-8fad-38f6b699d015

	measure 'Delta 24 h' =
			SUMX (
			    VALUES ( Tags[Tag] ),
			    VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			    VAR v1 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t1 )
			    VAR t0 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Mediciones[FechaHora] <= t1 - 1 )
			    VAR v0 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t0 )
			    RETURN
			        IF ( NOT ISBLANK ( t0 ), v1 - v0 )
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: 1 Base
		lineageTag: a9993499-9e19-4b55-9039-3f7a99277c48

	measure 'Delta 7 d' =
			SUMX (
			    VALUES ( Tags[Tag] ),
			    VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			    VAR v1 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t1 )
			    VAR t0 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Mediciones[FechaHora] <= t1 - 7 )
			    VAR v0 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t0 )
			    RETURN
			        IF ( NOT ISBLANK ( t0 ), v1 - v0 )
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: 1 Base
		lineageTag: 6f348566-a5ce-4516-84da-b2df0dbd83cb

	/// Promedio de las muestras de las últimas 24 h (para gráficos).
	measure 'Serie 24 h' = CALCULATE ( AVERAGE ( Mediciones[Valor] ), Mediciones[HorasAtras] <= 24 )
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: 1d479557-062e-477d-8942-e448f90e4367

	/// Promedio de las muestras de las últimas 72 h (para gráficos).
	measure 'Serie 72 h' = CALCULATE ( AVERAGE ( Mediciones[Valor] ), Mediciones[HorasAtras] <= 72 )
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: e9a127d5-3dd6-4bfa-b986-de35e9c4af4a

	/// Promedio de las muestras de las últimas 168 h (para gráficos).
	measure 'Serie 7 d' = CALCULATE ( AVERAGE ( Mediciones[Valor] ), Mediciones[HorasAtras] <= 168 )
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: d17d30bb-1e95-4764-831f-ee63aa664da2

	/// Igual que 'Serie 24 h' pero convierte m³/h a L/s (para los gráficos de caudal).
	measure 'Serie 24 h (L/s)' = DIVIDE ( [Serie 24 h], 3.6 )
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: 789bd0c2-137d-4c56-885b-23c46d76512d

	/// Igual que 'Serie 7 d' pero convierte m³/h a L/s (para los gráficos de caudal).
	measure 'Serie 7 d (L/s)' = DIVIDE ( [Serie 7 d], 3.6 )
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: b80c5c5a-d3a5-44c4-8092-1edcf3ff5725

	measure 'Ultima actualizacion' = "Última muestra " & FORMAT ( CALCULATE ( MAX ( Mediciones[FechaHora] ), REMOVEFILTERS () ), "dd-mm-yyyy HH:mm" )
		displayFolder: 1 Base
		lineageTag: 4de5f565-f197-4c5e-b48e-a4a528fb9fd3

	measure 'Modo datos texto' = IF ( [Modo historiador] = 1, "Historiador", "CSV sintético" )
		displayFolder: 1 Base
		lineageTag: 9dacdd4a-8444-43a0-be87-76901ca45d22

	measure 'Color modo' = IF ( [Modo historiador] = 1, "#4F9DDE", "#7B61C9" )
		displayFolder: 1 Base
		lineageTag: f8ad92fd-3a25-4d4f-866c-0e5797762ea4

	/// Caudal instantáneo del pozo en L/s (la señal viene en m³/h; 1 L/s = 3,6 m³/h).
	measure 'Caudal actual' = DIVIDE ( CALCULATE ( [Valor actual], Tags[Medicion] = "Caudal" ), 3.6 )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: fbb97f62-5f2b-4e87-be47-d824e21ad7cf

	measure 'Corriente actual' = CALCULATE ( [Valor actual], Tags[Medicion] = "Corriente" )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: df51c306-d856-4c62-8282-bc646b3f0d41

	measure 'RUN actual' = CALCULATE ( [Valor actual], Tags[Medicion] = "RUN" )
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: a74a8b1d-56d3-4d86-bc2a-43fdc4cf36dd

	/// 1 bombeando · 3 detenido · 4 sin dato · 5 caudal congelado (regla configurable en la tabla Config).
	measure 'Estado pozo cod' =
			VAR m = [Minutos sin comunicacion]
			VAR run = [RUN actual]
			VAR qq = [Caudal actual]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( m ), BLANK (),
			        m > [Umbral horas sin dato] * 60, 4,
			        ISBLANK ( run ) && [Caudal congelado] > 0, 5,
			        ( NOT ISBLANK ( run ) && run = 0 ) || ( NOT ISBLANK ( qq ) && qq < [Caudal minimo bombeo] ), 3,
			        1
			    )
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: cb6ea541-aa6f-453e-a104-98fa2bc4c8b1

	measure 'Estado pozo' = SWITCH ( [Estado pozo cod], 1, "● Bombeando", 3, "■ Detenido", 4, "◌ Sin dato", 5, "◇ Caudal congelado" )
		displayFolder: 2 Recuperación
		lineageTag: 6b8a3bd5-f9c1-467d-b05b-7f71fd40f5ff

	measure 'Color estado pozo' = SWITCH ( [Estado pozo cod], 1, "#4F9DDE", 3, "#D64550", 4, "#A9B6C4", 5, "#F2A03D" )
		displayFolder: 2 Recuperación
		lineageTag: 0d004956-a83d-416e-a313-61e3f5f83ef8

	measure 'Pozos bombeando' = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo recuperacion" ), [Estado pozo cod] = 1 ) ) + 0
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: c540ba13-8ed5-4487-9eda-e53899613736

	measure 'Pozos detenidos' = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo recuperacion" ), [Estado pozo cod] = 3 ) ) + 0
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: 13349335-0e6e-42ad-8aa4-669c4e45ae21

	measure 'Pozos sin dato' = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo recuperacion" ), [Estado pozo cod] = 4 ) ) + 0
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: ac3d6691-eba9-48b1-860e-7e2180009811

	measure 'Pozos recuperacion' = CALCULATE ( COUNTROWS ( Activos ), Activos[Tipo] = "Pozo recuperacion" ) + 0
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: 8747e858-76d9-43c8-8311-3c1933ec612f

	measure 'KPI recuperacion' = FORMAT ( [Pozos bombeando], "0" ) & " / " & FORMAT ( [Pozos recuperacion], "0" )
		displayFolder: 2 Recuperación
		lineageTag: f184fff6-b8cc-43e3-a085-6bb3d32abecd

	measure 'KPI recuperacion detalle' = FORMAT ( [Pozos detenidos], "0" ) & " detenido · " & FORMAT ( [Pozos sin dato], "0" ) & " sin dato" & IF ( [Pozos congelados] > 0, " · " & FORMAT ( [Pozos congelados], "0" ) & " congelado", "" )
		displayFolder: 2 Recuperación
		lineageTag: 11fa6793-8b3c-4fe7-8299-51d83dd3c31d

	measure 'Caudal recuperacion (L/s)' = CALCULATE ( [Caudal actual], Activos[Tipo] = "Pozo recuperacion" )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: 3e0f8722-39af-4ce2-82ea-15bfe6744110

	measure 'Caudal Norte (L/s)' = CALCULATE ( [Caudal recuperacion (L/s)], Activos[Circuito] = "Circuito Norte" )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: bf10c47d-fcee-4f37-a6ad-405baf1f6e6d

	measure 'Caudal Sur (L/s)' = CALCULATE ( [Caudal recuperacion (L/s)], Activos[Circuito] = "Circuito Sur" )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: c9018621-ee6c-4c12-a66e-a1a42bd12a08

	measure 'KPI Norte' = FORMAT ( [Caudal Norte (L/s)], "#,0.0" ) & " L/s"
		displayFolder: 2 Recuperación
		lineageTag: 26fad5a0-7269-4729-8ca3-f719da004930

	measure 'KPI Norte detalle' = "Meta " & FORMAT ( [Meta recuperacion Norte], "0" ) & " L/s · " & FORMAT ( DIVIDE ( [Caudal Norte (L/s)], [Meta recuperacion Norte] ), "0 %" ) & " de la meta"
		displayFolder: 2 Recuperación
		lineageTag: b27f9dc0-46f7-4d01-9d33-8b9b6d987554

	measure 'KPI Sur' = FORMAT ( [Caudal Sur (L/s)], "#,0.0" ) & " L/s"
		displayFolder: 2 Recuperación
		lineageTag: 49abd266-a0b3-48e4-91a7-93146a01a9ed

	measure 'KPI Sur detalle' = "Meta " & FORMAT ( [Meta recuperacion Sur], "0" ) & " L/s · " & FORMAT ( DIVIDE ( [Caudal Sur (L/s)], [Meta recuperacion Sur] ), "0 %" ) & " de la meta"
		displayFolder: 2 Recuperación
		lineageTag: 6a730b1f-74ec-477d-98d1-ebb22ec3ab59

	/// Estado del pozo en cada hora de las últimas 24 h (matriz).
	measure 'Estado hora cod' =
			VAR h = SELECTEDVALUE ( Horas24[HorasAtras] )
			VAR a = [Ahora]
			VAR t1 = a - h / 24
			VAR t0 = a - ( h + 1 ) / 24
			VAR n = CALCULATE ( COUNTROWS ( Mediciones ), KEEPFILTERS ( Tags[Medicion] IN { "RUN", "Caudal", "Corriente" } ), Mediciones[FechaHora] > t0, Mediciones[FechaHora] <= t1 )
			VAR runMin = CALCULATE ( MIN ( Mediciones[Valor] ), Tags[Medicion] = "RUN", Mediciones[FechaHora] > t0, Mediciones[FechaHora] <= t1 )
			VAR qMin = DIVIDE ( CALCULATE ( MIN ( Mediciones[Valor] ), Tags[Medicion] = "Caudal", Mediciones[FechaHora] > t0, Mediciones[FechaHora] <= t1 ), 3.6 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( h ), BLANK (),
			        COUNTROWS ( Tags ) = 0, BLANK (),
			        n = 0, 4,
			        ( NOT ISBLANK ( runMin ) && runMin = 0 ) || ( NOT ISBLANK ( qMin ) && qMin < [Caudal minimo bombeo] ), 3,
			        1
			    )
		formatString: 0
		displayFolder: 2 Recuperación
		lineageTag: ba0a5fad-9d08-46fa-9f77-77ef6fd9d888

	measure 'Color estado hora' = SWITCH ( [Estado hora cod], 1, "#4F9DDE", 3, "#D64550", 4, "#E6ECF2" )
		displayFolder: 2 Recuperación
		lineageTag: 34c2ce08-df13-4a7c-b2b6-ccb9b48ecd85

	measure 'Pozo seleccionado' = IF ( HASONEVALUE ( Activos[Activo] ), VALUES ( Activos[Activo] ), "Seleccione un pozo en la tabla" )
		displayFolder: 2 Recuperación
		lineageTag: 41f13bf8-d4d8-4dae-bd75-6d3e8581aa0d

	measure 'Tags del activo' = IF ( HASONEVALUE ( Activos[ActivoID] ), CONCATENATEX ( Tags, Tags[Tag], " · ", Tags[Tag], ASC ), "—" )
		displayFolder: 2 Recuperación
		lineageTag: ce4c5412-2519-4b2e-bd29-4a09bd3719d9

	measure 'Desde detenido' =
			VAR ultUno = CALCULATE ( MAX ( Mediciones[FechaHora] ), Tags[Medicion] = "RUN", Mediciones[Valor] = 1 )
			RETURN
			    CALCULATE ( MIN ( Mediciones[FechaHora] ), Tags[Medicion] = "RUN", Mediciones[FechaHora] > ultUno )
		formatString: dd-mm HH:mm
		displayFolder: 2 Recuperación
		lineageTag: 5031d7f4-3d2a-45fd-90fc-01444cb67c0a

	/// Nivel del sensor principal del estanque (%).
	measure 'Nivel estanque' = AVERAGEX ( CALCULATETABLE ( VALUES ( Tags[Tag] ), Tags[Medicion] = "Nivel estanque", Tags[Principal] = "Si" ), [Valor actual] )
		formatString: 0.0
		displayFolder: 3 Estanques
		lineageTag: 7256e279-dd6b-4ec7-b525-bf16e6a8bc38

	measure 'HI estanque' =
			VAR v = CALCULATE ( [Valor actual], Tags[Medicion] = "Limite HI" )
			RETURN
			    IF ( ISBLANK ( v ), [HI por defecto], v )
		formatString: 0
		displayFolder: 3 Estanques
		lineageTag: 9d5a4872-9b18-47b7-acfa-8ddc02a93271

	measure 'HH estanque' =
			VAR v = CALCULATE ( [Valor actual], Tags[Medicion] = "Limite HH" )
			RETURN
			    IF ( ISBLANK ( v ), [HH por defecto], v )
		formatString: 0
		displayFolder: 3 Estanques
		lineageTag: 1ee5ae41-b48e-43bb-b4e5-220b55fe793c

	measure 'Origen limites' = IF ( ISBLANK ( CALCULATE ( [Valor actual], Tags[Medicion] = "Limite HI" ) ), "Por defecto (sin señal)", "Historiador" )
		displayFolder: 3 Estanques
		lineageTag: 453ed876-1800-4a5a-bc58-eabaf806c351

	/// Umbral de aviso de ejemplo.
	measure 'Umbral aviso ejemplo' = "(ejemplo)"
		displayFolder: 3 Estanques
		lineageTag: dd05a72b-183c-40d3-abe9-86e3d559c104

	measure 'Tasa estanque (%/h)' =
			AVERAGEX (
			    CALCULATETABLE ( VALUES ( Tags[Tag] ), Tags[Medicion] = "Nivel estanque", Tags[Principal] = "Si" ),
			    VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			    VAR v1 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t1 )
			    VAR t0 = CALCULATE ( MAX ( Mediciones[FechaHora] ), Mediciones[FechaHora] <= t1 - 3 / 24 )
			    VAR v0 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t0 )
			    VAR horas = DATEDIFF ( t0, t1, MINUTE ) / 60
			    RETURN
			        IF ( NOT ISBLANK ( t0 ), DIVIDE ( v1 - v0, horas ) )
			)
		formatString: +0.0;-0.0;0.0
		displayFolder: 3 Estanques
		lineageTag: dcb2c92f-f27a-4b19-a99f-9dc68b2b973d

	measure 'Margen a HH' = [HH estanque] - [Nivel estanque]
		formatString: 0.0
		displayFolder: 3 Estanques
		lineageTag: d900b4cb-d250-4992-b65b-8dd5271c78bf

	measure 'Horas a HH' =
			VAR n = [Nivel estanque]
			VAR hh = [HH estanque]
			VAR r = [Tasa estanque (%/h)]
			RETURN
			    IF ( r > 0.05 && n < hh, DIVIDE ( hh - n, r ) )
		formatString: 0.0
		displayFolder: 3 Estanques
		lineageTag: 44fac52d-ef5d-4b03-a72b-4b4e74a7d141

	measure 'Llega a HH texto' =
			VAR h = [Horas a HH]
			RETURN
			    IF (
			        ISBLANK ( h ),
			        "Sin riesgo a la tasa actual",
			        "~" & FORMAT ( INT ( h ), "0" ) & " h " & FORMAT ( ( h - INT ( h ) ) * 60, "00" ) & " min"
			    )
		displayFolder: 3 Estanques
		lineageTag: 2dc06e6c-1ce4-4680-b225-ba44028a75f3

	measure 'Bombas en servicio' = CALCULATE ( [RUN actual], Activos[Tipo] = "Estanque" ) + 0
		formatString: 0
		displayFolder: 3 Estanques
		lineageTag: d4f43a46-db20-40c2-b733-e7afbe5a470c

	measure 'Bombas estanque' = CALCULATE ( COUNTROWS ( Tags ), Tags[Medicion] = "RUN", Activos[Tipo] = "Estanque" ) + 0
		formatString: 0
		displayFolder: 3 Estanques
