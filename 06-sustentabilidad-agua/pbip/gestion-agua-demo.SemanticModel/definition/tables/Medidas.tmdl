	/// Señales analógicas sin ningún cambio en las últimas Horas para congelado (no cuenta las que están en cero).
	measure 'Tag congelado' =
			SUMX (
			    CALCULATETABLE ( VALUES ( Tags[Tag] ), KEEPFILTERS ( Tags[Medicion] IN { "Caudal", "Caudal total", "Nivel pozo", "Profundidad", "pH", "CE", "Nivel estanque", "Corriente", "Nivel tranque", "Caudal aforador", "pH tranque", "Bateria" } ) ),
			    VAR t1 = CALCULATE ( MAX ( Mediciones[FechaHora] ) )
			    VAR t0 = t1 - [Horas para congelado] / 24
			    VAR tmin = CALCULATE ( MIN ( Mediciones[FechaHora] ) )
			    VAR v1 = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] = t1 )
			    VAR mx = CALCULATE ( MAX ( Mediciones[Valor] ), Mediciones[FechaHora] >= t0 )
			    VAR mn = CALCULATE ( MIN ( Mediciones[Valor] ), Mediciones[FechaHora] >= t0 )
			    VAR n = CALCULATE ( COUNTROWS ( Mediciones ), Mediciones[FechaHora] >= t0 )
			    RETURN
			        IF ( NOT ISBLANK ( t1 ) && tmin <= t0 && n >= 8 && ABS ( v1 ) > 0.01 && mx - mn <= 0.000001, 1, 0 )
			)
		formatString: 0
		displayFolder: 6 Datos
		lineageTag: c49d8d5d-ba6e-42b9-bf3d-876650c6dae9

	measure 'Tags congelados' = [Tag congelado] + 0
		formatString: 0
		displayFolder: 6 Datos
		lineageTag: f823cdd1-3b83-4ab5-8aaa-cc808b2bcdcb

	measure 'Nivel estanque congelado' = CALCULATE ( [Tag congelado], KEEPFILTERS ( Tags[Medicion] = "Nivel estanque" ), KEEPFILTERS ( Tags[Principal] = "Si" ) )
		formatString: 0
