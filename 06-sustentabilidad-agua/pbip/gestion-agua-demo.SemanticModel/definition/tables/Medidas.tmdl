		lineageTag: 7aa85b05-75de-4589-8fc4-3705974d60eb

	measure 'Sem Estanques detalle' = FORMAT ( [Estanques sobre HI], "0" ) & " de " & FORMAT ( [Estanques total], "0" ) & " sobre HI · " & [KPI margen detalle]
		displayFolder: 11 Semáforos
		lineageTag: 0a1a8d77-cef2-492c-b0f3-53b294ea6f60

	measure 'Sem Tranques cod' =
			VAR sev = MAXX ( CALCULATETABLE ( Activos, Activos[Tipo] = "Tranque" ), [Alarma severidad] )
			RETURN
			    IF ( sev = 3, 3, IF ( sev >= 1, 2, 1 ) )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: 98c3185d-304d-4323-ade6-d1f4aab3ce36

	measure 'Sem Tranques detalle' = FORMAT ( [Tranques en alerta], "0" ) & " de " & FORMAT ( [Tranques total], "0" ) & " en alerta · emergencia " & [Poza emergencia texto] & " · " & [Alarmas nivel alto tranques texto]
		displayFolder: 11 Semáforos
		lineageTag: 7f0f2f1a-8362-4d9d-a892-aa7f16532872

	measure 'Sem Aguas abajo cod' =
			VAR a = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo monitoreo" ), [Estado aguas abajo cod] = 3 ) )
			VAR b = COUNTROWS ( FILTER ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo monitoreo" ), [Estado aguas abajo cod] IN { 2, 4, 5 } ) )
			RETURN
			    IF ( a > 0, 3, IF ( b > 0, 2, 1 ) )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: c942811f-47fe-40fe-9914-ab581eebb73b

	measure 'Sem Aguas abajo detalle' = FORMAT ( [Pozos aguas abajo subiendo], "0" ) & " de " & FORMAT ( [Pozos aguas abajo], "0" ) & " pozos de monitoreo con el nivel subiendo en 7 d · asociación a circuitos por validar"
		displayFolder: 11 Semáforos
		lineageTag: bd33234e-e6f8-4298-bd31-f672968ecfa4

	measure 'Sem Agua fresca cod' =
			VAR sev = MAXX ( CALCULATETABLE ( Activos, Activos[Tipo] = "Pozo agua fresca" ), [Alarma severidad] )
			VAR pcupo = [% cupo captacion]
			RETURN
			    IF ( pcupo > 1 || sev = 3, 3, IF ( sev >= 1 || COALESCE ( [Pozos AF sin comunicacion], 0 ) > 0, 2, 1 ) )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: b313cea0-1a2a-4a7b-b010-466d45bad443

	measure 'Sem Agua fresca detalle' = FORMAT ( [Caudal agua fresca total], "0.0" ) & " L/s (" & FORMAT ( [% cupo captacion], "0 %" ) & " del cupo) · " & FORMAT ( [Pozos sobre cupo], "0" ) & " pozo(s) sobre su cupo al cierre · " & FORMAT ( COALESCE ( [Pozos AF sin comunicacion], 0 ), "0" ) & " sin comunicación"
		displayFolder: 11 Semáforos
		lineageTag: 9af0ef62-32b0-4d29-900f-c220335a194f

	measure 'Sem Calidad cod' =
			VAR sev = MAXX ( CALCULATETABLE ( Activos, Activos[Tipo] = "Estacion calidad" ), [Alarma severidad] )
			RETURN
			    IF ( sev = 3, 3, IF ( sev >= 1, 2, 1 ) )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: 50583626-2851-4d38-9cd7-fdcd40be7574

	measure 'Sem Calidad detalle' = [KPI pH] & " estaciones en banda de pH · " & [KPI pH detalle]
		displayFolder: 11 Semáforos
		lineageTag: 66a16115-fc5b-4b09-863e-96dc58e1e3c1

	measure 'Sem Energia cod' =
			VAR caidas = [Estaciones sin comunicacion]
			VAR cortes = [Estaciones con posible corte]
			RETURN
			    IF (
			        caidas > 0 || cortes > 0,
			        3,
			        IF ( [Salas UPS en alarma] > 0 || [Estaciones bateria baja] > 0 || COALESCE ( [Pozos AF sin comunicacion], 0 ) > 0 || COALESCE ( [Falla enlace], 0 ) >= 1, 2, 1 )
			    )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: e573b474-6522-4a8c-bdb9-ce7d5aeaf377

	measure 'Sem Energia detalle' = FORMAT ( [Estaciones sin comunicacion], "0" ) & " estación(es) sin comunicación · " & FORMAT ( [Estaciones con posible corte], "0" ) & " posible corte · " & FORMAT ( [Salas UPS en alarma], "0" ) & " UPS en alarma · " & FORMAT ( [Estaciones bateria baja], "0" ) & " baterías bajas"
		displayFolder: 11 Semáforos
		lineageTag: c3763405-edd3-4407-aa47-c51074ed5d66

	measure 'Sem Reporte cod' = IF ( [Pozos reporte A sin envio 24 h] > 0, 3, IF ( [Pozos reporte A atrasados] > 0 || [Puntos reporte B con errores] > 0, 2, 1 ) )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: 5a32af4b-b3b5-4d17-8379-f698b79c9e2a

	measure 'Sem Reporte detalle' = "Portal A: " & FORMAT ( [Pozos reporte A atrasados], "0" ) & " de " & FORMAT ( [Pozos reporte A], "0" ) & " pozos atrasados · Portal B: " & FORMAT ( [Puntos reporte B con errores], "0" ) & " de " & FORMAT ( [Puntos reporte B], "0" ) & " envíos con errores"
		displayFolder: 11 Semáforos
		lineageTag: db1a73e3-837a-4daf-901f-3ba062c9accb

	measure 'Sem Datos cod' = IF ( [Datos atrasados] = 1, 3, IF ( [% tags con dato] < 0.9 || [Tags congelados] > 0, 2, 1 ) )
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: f1e648b3-7e4d-488e-9235-24ad51d9cb12

	measure 'Sem Datos detalle' = "Datos al " & FORMAT ( [Datos al], "dd-mm HH:mm" ) & " · " & FORMAT ( [% tags con dato], "0 %" ) & " de los tags con dato · " & FORMAT ( [Tags congelados], "0" ) & " congelados"
		displayFolder: 11 Semáforos
		lineageTag: 4cf22fdc-dd8a-4936-b91d-aa793a68fd89

	/// 3 crítico · 2 alerta · 1 normal, según el sistema filtrado en Semaforo[Sistema].
	measure 'Sem cod' =
			SWITCH (
			    SELECTEDVALUE ( Semaforo[Sistema] ),
			    "Recuperación Norte", [Sem Recuperacion Norte cod],
			    "Recuperación Sur", [Sem Recuperacion Sur cod],
			    "Estanques", [Sem Estanques cod],
			    "Tranques y pozas", [Sem Tranques cod],
			    "Aguas abajo", [Sem Aguas abajo cod],
			    "Agua fresca", [Sem Agua fresca cod],
			    "Calidad de agua", [Sem Calidad cod],
			    "Energía y comunicaciones", [Sem Energia cod],
			    "Reporte externo", [Sem Reporte cod],
			    "Actualización de datos", [Sem Datos cod]
			)
		formatString: 0
		displayFolder: 11 Semáforos
		lineageTag: 2e30e77c-5f12-46f8-a8d4-f325c86569ea

	measure 'Sem estado' = SWITCH ( [Sem cod], 3, "CRÍTICO", 2, "ALERTA", 1, "NORMAL", "SIN DATO" )
		displayFolder: 11 Semáforos
		lineageTag: bcf10f36-d21b-4e4b-9ae9-889af0b62c72

	measure 'Sem color' = SWITCH ( [Sem cod], 3, "#D64550", 2, "#F2A03D", 1, "#2E9E6B", "#A9B6C4" )
		displayFolder: 11 Semáforos
		lineageTag: b1ed64da-ec62-4ab0-8522-cbd39c8be044

	measure 'Sem color texto' = IF ( [Sem cod] = 2, "#1B2A41", "#FFFFFF" )
		displayFolder: 11 Semáforos
		lineageTag: 68058034-626f-4bbc-89ba-2de252f586c9

	measure 'Sem detalle' =
			SWITCH (
			    SELECTEDVALUE ( Semaforo[Sistema] ),
			    "Recuperación Norte", [Sem Recuperacion Norte detalle],
			    "Recuperación Sur", [Sem Recuperacion Sur detalle],
			    "Estanques", [Sem Estanques detalle],
			    "Tranques y pozas", [Sem Tranques detalle],
			    "Aguas abajo", [Sem Aguas abajo detalle],
			    "Agua fresca", [Sem Agua fresca detalle],
			    "Calidad de agua", [Sem Calidad detalle],
			    "Energía y comunicaciones", [Sem Energia detalle],
			    "Reporte externo", [Sem Reporte detalle],
			    "Actualización de datos", [Sem Datos detalle]
			)
		displayFolder: 11 Semáforos
		lineageTag: 0121df73-e677-4c1f-bbd1-6f159ca2b166

	measure 'Sem titulo' = UPPER ( SELECTEDVALUE ( Semaforo[Sistema] ) )
		displayFolder: 11 Semáforos
		lineageTag: 2609dc1a-512f-42e3-b47a-015e75bd8da3

	measure 'Limite turbidez' = CALCULATE ( MAX ( Config[Valor] ), Config[Parametro] = "Turbidez maxima (NTU)" )
		formatString: 0
		displayFolder: 0 Parámetros
		lineageTag: d78c9d46-4465-4c3d-a2cb-01c30d6375b3

	measure 'Turbidez actual' = CALCULATE ( [Valor actual], Tags[Medicion] = "Turbidez" )
		formatString: 0.0
		displayFolder: 5 Calidad
		lineageTag: cfd448ca-49f7-4b21-aaed-ae9365299c3d

	/// Caudal total de agua recuperada y recirculada en L/s (la señal viene en m³/h).
	measure 'Caudal recuperada total' = DIVIDE ( CALCULATE ( [Valor actual], Tags[Medicion] = "Caudal recuperada total" ), 3.6 )
		formatString: #,0.0
		displayFolder: 2 Recuperación
		lineageTag: 29fbab2e-ea11-4ac3-b7cb-110b70633011

	/// Último día con balance diario.
	measure 'Fecha corte balance' = CALCULATE ( MAX ( BalanceDiario[Fecha] ), REMOVEFILTERS () )
		formatString: dd-mm-yyyy
		displayFolder: 12 Balance
		lineageTag: 0d354d45-7c26-4bf8-b1d0-8aaa73fc0944

	/// Volumen diario (m³) del concepto «Captación» en el contexto de filtro.
	measure 'Vol captacion' = CALCULATE ( SUM ( BalanceDiario[Volumen_m3] ), BalanceDiario[Concepto] = "Captación" )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 39be26f6-84de-43a7-bf40-56e760e81ad3

	/// Volumen diario (m³) del concepto «Pérdida de conducción» en el contexto de filtro.
	measure 'Vol perdida conduccion' = CALCULATE ( SUM ( BalanceDiario[Volumen_m3] ), BalanceDiario[Concepto] = "Pérdida de conducción" )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 236a6ecb-ca73-4c67-b129-be2427bf9d73

	/// Volumen diario (m³) del concepto «Agua fresca» en el contexto de filtro.
	measure 'Vol agua fresca' = CALCULATE ( SUM ( BalanceDiario[Volumen_m3] ), BalanceDiario[Concepto] = "Agua fresca" )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 7788d6d4-9bd3-4f25-9fd9-e0ae2615ab8e

	/// Volumen diario (m³) del concepto «Agua recuperada» en el contexto de filtro.
	measure 'Vol agua recuperada' = CALCULATE ( SUM ( BalanceDiario[Volumen_m3] ), BalanceDiario[Concepto] = "Agua recuperada" )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: ab0c35c9-32fd-4c2b-aab8-2ab427ec3e45

	/// Volumen diario (m³) del concepto «Consumo» en el contexto de filtro.
	measure 'Vol consumo' = CALCULATE ( SUM ( BalanceDiario[Volumen_m3] ), BalanceDiario[Concepto] = "Consumo" )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 944a25a5-4c0f-4db5-8c0e-eb0ed28f88dc

	/// Volumen diario (m³) del concepto «Variación de almacenamiento» en el contexto de filtro.
	measure 'Vol variacion almacenamiento' = CALCULATE ( SUM ( BalanceDiario[Volumen_m3] ), BalanceDiario[Concepto] = "Variación de almacenamiento" )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 2afdc4f8-0f2d-4b2c-8b3c-89fd68a48764

	/// Agua total de proceso = agua fresca (reposición) + agua recuperada.
	measure 'Vol agua total' = [Vol agua fresca] + [Vol agua recuperada]
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: ccbf915f-18d7-41ae-b8f1-eec38e625a36

	/// Parte del agua de proceso que proviene de la recuperación.
	measure 'Recirculacion %' = DIVIDE ( [Vol agua recuperada], [Vol agua total] )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: 17b3807f-87ea-4076-90ec-23c8bb43e4b4

	/// Agua total - consumo - variación de almacenamiento.
	measure 'Error balance (m3)' = [Vol agua total] - [Vol consumo] - [Vol variacion almacenamiento]
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 01ec6fda-37d2-4021-861f-9947fde8c950

	/// 100 % = el balance cierra sin residuo.
	measure 'Cierre balance %' = 1 - DIVIDE ( ABS ( [Error balance (m3)] ), [Vol agua total] )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: 577df4eb-5498-43bf-a8ed-76c4ee9be2d2

	/// Agua fresca de los últimos 7 días con balance.
	measure 'Agua fresca 7 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol agua fresca], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 7 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 7fd23852-0532-4cdc-94bf-6cab4bb6dcdf

	/// Agua recuperada de los últimos 7 días con balance.
	measure 'Agua recuperada 7 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol agua recuperada], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 7 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 1a137417-d6fa-499f-82e5-b4c492aee9e4

	/// Consumo de los últimos 7 días con balance.
	measure 'Consumo 7 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol consumo], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 7 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: b1339744-97cd-4aaf-ab43-0db8e8bbc71f

	/// Captación de los últimos 7 días con balance.
	measure 'Captacion 7 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol captacion], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 7 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: fd303eca-97b9-4993-839f-2805173e6e1a

	measure 'Recirculacion 7 d %' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Recirculacion %], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 7 ) )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: cf15f486-e781-4e12-a32f-94c62a8ebeb9

	measure 'Cierre balance 7 d %' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Cierre balance %], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 7 ) )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: f0e28b23-578b-491b-aed7-c56ef162d1cf

	/// Agua fresca de los últimos 30 días con balance.
	measure 'Agua fresca 30 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol agua fresca], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 30 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: eda7a0e6-a975-4eca-aec5-c797ae291ce2

	/// Agua recuperada de los últimos 30 días con balance.
	measure 'Agua recuperada 30 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol agua recuperada], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 30 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 11543da8-2da4-404d-bfe0-94a04369921d

	/// Consumo de los últimos 30 días con balance.
	measure 'Consumo 30 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol consumo], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 30 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 1de6a74a-4143-4666-aebc-2619ffa560bd

	/// Captación de los últimos 30 días con balance.
	measure 'Captacion 30 d (m3)' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Vol captacion], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 30 ) )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: 112631a6-e005-4ae0-9de4-022a045e04b3

	measure 'Recirculacion 30 d %' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Recirculacion %], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 30 ) )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: addd3432-fa0d-4139-9b9e-78a1011f14e6

	measure 'Cierre balance 30 d %' =
			VAR f = [Fecha corte balance]
			RETURN
			    CALCULATE ( [Cierre balance %], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > f - 30 ) )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: ab9a6e95-b9cc-4d05-a83f-e3b81a66bbcc

	/// Participación del área en el consumo de los últimos 30 días.
	measure '% consumo 30 d' = DIVIDE ( [Consumo 30 d (m3)], CALCULATE ( [Consumo 30 d (m3)], REMOVEFILTERS ( BalanceDiario[Area] ) ) )
		formatString: 0.0 %
		displayFolder: 12 Balance
		lineageTag: ab3b092d-91df-4d6b-a48d-54ebb638dfb0

	measure 'Fresca promedio diaria 7 d (m3)' = DIVIDE ( [Agua fresca 7 d (m3)], 7 )
		formatString: #,0
		displayFolder: 12 Balance
		lineageTag: e1aa8b75-fb4c-4ca8-8bf3-4147477b3faa

	measure 'KPI agua fresca 7 d detalle' = "Promedio " & FORMAT ( [Fresca promedio diaria 7 d (m3)], "#,0" ) & " m³/día · reposición"
		displayFolder: 12 Balance
		lineageTag: 1a81ec4f-0c49-42ef-951a-d851e329335a

	measure 'KPI agua recuperada 7 d detalle' = "Pozos de recuperación + retorno del Tranque Demo"
		displayFolder: 12 Balance
		lineageTag: 2e8b240b-0d5b-4096-954b-adb68e1b0614

	measure 'KPI consumo 7 d detalle' = "Chancado, molienda, flotación, mina y servicios"
		displayFolder: 12 Balance
		lineageTag: 198d614f-4710-4e08-adba-e06d5c86713c

	measure 'KPI recirculacion detalle' = "Recuperada / (fresca + recuperada) · 7 días"
		displayFolder: 12 Balance
		lineageTag: ca80266c-ad13-4636-9d13-769204b7c953

	measure 'KPI cierre detalle' = "Error 7 d: " & FORMAT ( CALCULATE ( [Error balance (m3)], FILTER ( ALL ( BalanceDiario[Fecha] ), BalanceDiario[Fecha] > [Fecha corte balance] - 7 ) ), "#,0" ) & " m³"
		displayFolder: 12 Balance
		lineageTag: 576ebea2-c981-474a-a66f-afbb27c4b0cb

	column Columna
		dataType: string
		isHidden
		lineageTag: 3c22e57b-7b99-4bd3-a22f-cf15b11dd505
		summarizeBy: none
		sourceColumn: Columna

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = #table(type table [Columna = text], {})
				in
				    Origen

	annotation PBI_ResultType = Table

