	measure 'Horas a HH activo' = SWITCH ( SELECTEDVALUE ( Activos[Tipo] ), "Estanque", [Horas a HH], "Tranque", [Horas a HH tranque] )
		formatString: 0.0
		displayFolder: 8 Tranques
		lineageTag: 80fcbeea-43b3-4f4b-a3c5-7210a66fbbb1

	/// Tiempo estimado al rebalse: (HH − nivel) / velocidad de subida de las últimas 3 h.
	measure 'Rebalse texto' =
			VAR tipo = SELECTEDVALUE ( Activos[Tipo] )
			VAR h = [Horas a HH activo]
			VAR n = IF ( tipo = "Estanque", [Nivel estanque], [Nivel tranque] )
			VAR hh = IF ( tipo = "Estanque", [HH estanque], [HH tranque] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( n ) || ISBLANK ( hh ), "—",
			        n >= hh, "Sobre HH",
			        ISBLANK ( h ), "Estable o bajando",
			        h < 1, "Llega a HH en menos de 1 h",
			        h < 48, "Llega a HH en ~" & FORMAT ( INT ( h ), "0" ) & " h",
			        "Llega a HH en ~" & FORMAT ( INT ( h / 24 ), "0" ) & " d"
			    )
		displayFolder: 8 Tranques
		lineageTag: aea38d04-40b3-4f5d-a490-c4850a3e7481

	measure 'Menor horas a HH' = MINX ( FILTER ( CALCULATETABLE ( Activos, KEEPFILTERS ( Activos[Tipo] IN { "Estanque", "Tranque" } ) ), NOT ISBLANK ( [Horas a HH activo] ) ), [Horas a HH activo] )
		formatString: 0.0
		displayFolder: 8 Tranques
		lineageTag: e67f3e86-3e11-42fe-ac91-b3d3b7bf163b

	measure 'Rebalse proximo texto' =
			VAR t = TOPN ( 1, FILTER ( CALCULATETABLE ( Activos, KEEPFILTERS ( Activos[Tipo] IN { "Estanque", "Tranque" } ) ), NOT ISBLANK ( [Horas a HH activo] ) ), [Horas a HH activo], ASC )
			RETURN
			    IF ( ISEMPTY ( t ), "Ningún estanque ni tranque sube hacia HH", CONCATENATEX ( t, Activos[Activo] & " · " & [Rebalse texto], ", " ) )
		displayFolder: 8 Tranques
		lineageTag: 8072755d-6031-413a-9d31-9fe7a4733439

