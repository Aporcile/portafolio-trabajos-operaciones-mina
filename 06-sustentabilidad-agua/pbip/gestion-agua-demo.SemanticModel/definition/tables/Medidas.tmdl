	measure 'Detencion mas larga texto' =
			VAR t = TOPN ( 1, FILTER ( CALCULATETABLE ( Activos, KEEPFILTERS ( Activos[Tipo] = "Pozo recuperacion" ) ), [Estado pozo cod] = 3 ), [Horas detenido real], DESC )
			RETURN
			    IF ( ISEMPTY ( t ), "Sin pozos detenidos", "Detención más larga: " & CONCATENATEX ( t, Activos[Activo] & " · " & [Detenido hace], ", " ) )
