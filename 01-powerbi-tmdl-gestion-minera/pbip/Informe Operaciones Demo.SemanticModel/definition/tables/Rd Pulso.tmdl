table 'Rd Pulso'
	isHidden
	lineageTag: 72cd42e7-3d24-4d97-9fb9-2fd6f1a1320f

	/// Hora de servidor de la fuente de pulso; permite el refresco automático de página con DirectQuery.
	measure 'Rd Pulso Ahora' = MAX ( 'Rd Pulso'[Ahora] )
		formatString: hh:nn:ss
		lineageTag: f2aee1cc-1e91-4b31-844a-6539c5ecb1c8

	column Ahora
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: f739dff8-5a8c-44f4-a5da-5c5fca86f845
		summarizeBy: none
		sourceColumn: Ahora

		annotation SummarizationSetBy = Automatic

	partition 'Rd Pulso' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "pulso.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Ahora", type datetime}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
