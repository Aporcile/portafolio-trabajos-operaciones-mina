table planta_plan_spi
	lineageTag: f1bf7736-f2a6-4cf2-89d4-cef295e1d93b

	column Fecha
		dataType: dateTime
		formatString: dd-mm-yyyy
		lineageTag: 50f6ca76-9ff9-4591-8445-c14a144cd3dd
		summarizeBy: none
		sourceColumn: Fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Valor
		dataType: double
		lineageTag: 4622042e-0272-4f70-acd5-629f65aa3e22
		summarizeBy: none
		sourceColumn: Valor

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition planta_plan_spi = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "planta_plan_spi.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type date}, {"Valor", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
