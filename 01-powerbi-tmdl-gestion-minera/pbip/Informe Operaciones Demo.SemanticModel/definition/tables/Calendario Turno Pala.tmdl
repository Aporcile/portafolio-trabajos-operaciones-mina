table 'Calendario Turno Pala'
	lineageTag: 89a6969b-6bfe-4049-b267-9c9868bab92b

	column time
		dataType: dateTime
		formatString: General Date
		lineageTag: dd371af6-19cb-4c5b-b95e-01326fd4dcc7
		summarizeBy: none
		sourceColumn: time

		annotation SummarizationSetBy = Automatic

	column shift
		dataType: string
		lineageTag: 9e9c3b65-4c70-4961-8e08-9f5fab98070d
		summarizeBy: none
		sourceColumn: shift

		annotation SummarizationSetBy = Automatic

	column ShiftID = CONCATENATE( 'Calendario Turno Pala'[time], 'Calendario Turno Pala'[shift])
		lineageTag: 9fa1c06f-0bed-4fb0-a1ef-07730bba2d46
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Calendario Turno Pala' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "calendario_turno.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"time", type datetime}, {"shift", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
