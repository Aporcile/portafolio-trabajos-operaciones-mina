	partition hist_senales = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "hist_senales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"item_id", type text}, {"timestamp", type datetime}, {"numeric_value", type number}, {"estado", Int64.Type}, {"dim_variable.name", type text}, {"dim_variable.tipo_variable", type text}}, "en-US")
				in
