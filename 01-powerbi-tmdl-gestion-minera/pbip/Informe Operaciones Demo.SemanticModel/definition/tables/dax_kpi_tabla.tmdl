			        )
			)
		lineageTag: ee87a217-d909-414a-bb8f-135b6bd48bd6

	/// Porcentaje de finos de la correa de alimentación al SAG; solo muestras con el SAG cargado (más de 1.000 t/h).
	measure Valor_Finos =
			VAR _vivo = [Rd Pl Vivo]
			VAR _tN = CALCULATE ( MAX ( hist_kpi[timestamp] ), hist_kpi[nombre_tag] = "SAG.CORREA.FINOS_PCT", NOT ISBLANK ( hist_kpi[numeric_value] ) )
			VAR _w0 = IF ( _vivo, _tN - 0.01, [Rd Planta Inicio] )
			VAR _w1 = IF ( _vivo, _tN, [Rd Planta Fin] )
			VAR _m =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( hist_kpi[timestamp] ),
			            "@f", CALCULATE ( MAX ( hist_kpi[numeric_value] ), hist_kpi[nombre_tag] = "SAG.CORREA.FINOS_PCT" ),
			            "@sag", CALCULATE ( MAX ( hist_kpi[numeric_value] ), hist_kpi[nombre_tag] = "SAG.ALIM.TPH" )
			        ),
			        hist_kpi[timestamp] > _w0 + 0.0001,
			        hist_kpi[timestamp] <= _w1 + 0.0001
			    )
			RETURN AVERAGEX ( FILTER ( _m, NOT ISBLANK ( [@f] ) && [@sag] > 1000 ), [@f] )
		lineageTag: 0764ca15-5a7a-4642-95c9-2bf2f69f5640

	/// Dureza SPI (minutos): último valor de la ventana en línea, promedio del día de planta si está cerrado.
	measure Valor_SPI =
			IF (
			    [Rd Pl Vivo],
			    VAR _tag = "SAG.DUREZA.SPI"
			    VAR _fin = CALCULATE ( [Rd Planta Fin], REMOVEFILTERS ( Calendario ) )
			    VAR _t = CALCULATE ( MAX ( hist_kpi[timestamp] ), REMOVEFILTERS ( Calendario ), hist_kpi[nombre_tag] = _tag, NOT ISBLANK ( hist_kpi[numeric_value] ), hist_kpi[timestamp] <= _fin + 0.0001 )
			    RETURN CALCULATE ( MAX ( hist_kpi[numeric_value] ), REMOVEFILTERS ( Calendario ), hist_kpi[nombre_tag] = _tag, hist_kpi[timestamp] = _t ),
			    VAR _ini = [Rd Planta Inicio]
			    VAR _fin = [Rd Planta Fin]
			    RETURN
			        CALCULATE (
			            AVERAGE ( hist_kpi[numeric_value] ),
			            hist_kpi[nombre_tag] = "SAG.DUREZA.SPI",
			            hist_kpi[timestamp] > _ini + 0.0001,
			            hist_kpi[timestamp] <= _fin + 0.0001
			        )
			)
		lineageTag: 13dd6f75-a524-4417-ad62-a53a62a28159

	/// Retorno de pebbles (t/h) en las muestras con el SAG operando.
	measure Valor_Pebble =
			IF (
			    [Rd Pl Vivo],
			    CALCULATE(MAX(hist_kpi_ultima[numeric_value]), hist_kpi_ultima[nombre_tag] = "PEBBLES.RETORNO.TPH"),
			    VAR _ini = [Rd Planta Inicio]
			    VAR _fin = [Rd Planta Fin]
			    VAR _op =
			        CALCULATETABLE (
			            VALUES ( hist_kpi[timestamp] ),
			            hist_kpi[nombre_tag] = "SAG.ALIM.TPH",
			            hist_kpi[numeric_value] > 100,
			            hist_kpi[timestamp] > _ini + 0.0001,
			            hist_kpi[timestamp] <= _fin + 0.0001
			        )
			    RETURN CALCULATE ( AVERAGE ( hist_kpi[numeric_value] ), hist_kpi[nombre_tag] = "PEBBLES.RETORNO.TPH", _op )
			)
		lineageTag: 82b84baf-7d9b-47ae-8ca2-fac9c5ed2bb3

	/// P80 de la molienda (µm): último valor en línea, promedio del día de planta si está cerrado.
