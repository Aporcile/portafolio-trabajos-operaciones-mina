table dax_kpi_tabla
	lineageTag: 25cf5501-e871-4df8-a160-1bc72c51c93b

	/// Valor de planta por fecha: en línea, el último dato del historiador; en día cerrado, el cierre del día de planta.
	measure Valor_TPHChancado =
			IF (
			    [Rd Pl Vivo],
			    CALCULATE(MAX(hist_kpi_ultima[numeric_value]), hist_kpi_ultima[nombre_tag] = "CHANC.ALIM.TPH"),
			    DIVIDE ( [Valor_TChancadoProyectado], 24 )
			)
		lineageTag: 8e39a908-8e9f-40dc-97a0-e40d7b29545b

	/// Valor de planta por fecha: en línea, el último dato del historiador; en día cerrado, el cierre del día de planta.
	measure Valor_TPHChancadoAcumulado =
			IF (
			    [Rd Pl Vivo],
			    VAR _p = CALCULATE ( MAX ( hist_kpi_ultima[numeric_value] ), hist_kpi_ultima[nombre_tag] = "CHANC.ALIM.PROY_DIA" )
			    VAR _t =
			        CALCULATE (
			            MAX ( hist_kpi[timestamp] ),
			            REMOVEFILTERS ( Calendario ),
			            hist_kpi[nombre_tag] = "CHANC.ALIM.PROY_DIA",
			            NOT ISBLANK ( hist_kpi[numeric_value] )
			        )
			    VAR _ini = CALCULATE ( [Rd Planta Inicio], REMOVEFILTERS ( Calendario ) )
			    VAR _iniM = _ini + 1 / 24
			    VAR _h = ( _t - ( _iniM - ROUNDUP ( MAX ( _iniM - _t, 0 ), 0 ) ) ) * 24
			    RETURN IF ( NOT ISBLANK ( _p ) && NOT ISBLANK ( _t ) && NOT ISBLANK ( _ini ), _p * _h / 24 ),
			    [Valor_TChancadoProyectado]
			)
		lineageTag: 9d5d0a26-4433-4bbb-976e-d9b15e848f52

	/// Valor de planta por fecha: en línea, el último dato del historiador; en día cerrado, el cierre del día de planta.
	measure Valor_TChancadoProyectado =
			IF (
			    [Rd Pl Vivo],
			    CALCULATE(MAX(hist_kpi_ultima[numeric_value]), hist_kpi_ultima[nombre_tag] = "CHANC.ALIM.PROY_DIA"),
			    VAR _iniM = [Rd Planta Inicio] + 1 / 24
			    VAR _finM = [Rd Planta Fin] + 1 / 24
			    VAR _t =
			        CALCULATE (
			            MAX ( hist_kpi[timestamp] ),
			            hist_kpi[nombre_tag] = "CHANC.ALIM.PROY_DIA",
			            NOT ISBLANK ( hist_kpi[numeric_value] ),
			            hist_kpi[timestamp] > _iniM + 0.0001,
			            hist_kpi[timestamp] <= _finM - 0.01
			        )
			    RETURN
			        IF (
			            NOT ISBLANK ( _t ),
			            CALCULATE ( MAX ( hist_kpi[numeric_value] ), hist_kpi[nombre_tag] = "CHANC.ALIM.PROY_DIA", hist_kpi[timestamp] = _t )
			        )
			)
		lineageTag: 919ff4a9-53b1-4252-8ccb-6dbf7ef1eda2

	/// Nivel del stockpile de gruesos (%): último valor en línea, última muestra válida del día si está cerrado.
	measure Valor_Stockpile =
			IF (
			    [Rd Pl Vivo],
			    CALCULATE(MAX(hist_kpi_ultima[numeric_value]), hist_kpi_ultima[nombre_tag] = "STOCK.NIVEL.PCT"),
			    VAR _ini = [Rd Planta Inicio]
			    VAR _fin = [Rd Planta Fin]
			    VAR _t =
			        CALCULATE (
			            MAX ( hist_kpi[timestamp] ),
			            hist_kpi[nombre_tag] = "STOCK.NIVEL.PCT",
			            NOT ISBLANK ( hist_kpi[numeric_value] ),
			            hist_kpi[timestamp] > _ini + 0.0001,
			            hist_kpi[timestamp] <= _fin + 0.0001
			        )
			    RETURN
			        IF (
			            NOT ISBLANK ( _t ),
			            CALCULATE ( MAX ( hist_kpi[numeric_value] ), hist_kpi[nombre_tag] = "STOCK.NIVEL.PCT", hist_kpi[timestamp] = _t )
			        )
			)
		lineageTag: ae18fd61-9b5d-4691-b915-1b2f7b206613

	/// Rendimiento del SAG (t/h): último dato en línea; en día cerrado, el cierre oficial o el promedio con el SAG operando.
	measure Valor_TPHSAG =
			IF (
			    [Rd Pl Vivo],
			    CALCULATE(MAX(hist_kpi_ultima[numeric_value]), hist_kpi_ultima[nombre_tag] = "SAG.ALIM.TPH"),
			    VAR _ini = [Rd Planta Inicio]
			    VAR _fin = [Rd Planta Fin]
			    VAR _of = [Rd Planta Cierre TPH]
			    VAR _sq =
			        CALCULATE (
			            AVERAGE ( hist_kpi[numeric_value] ),
			            hist_kpi[nombre_tag] = "SAG.ALIM.TPH",
			            hist_kpi[numeric_value] > 100,
			            hist_kpi[timestamp] > _ini + 0.0001,
			            hist_kpi[timestamp] <= _fin + 0.0001
			        )
			    RETURN IF ( [Rd Planta Cierre Oficial] && _of > 0, _of, _sq )
			)
		lineageTag: b530b198-3179-4052-8774-ee510b685ca2

	/// Valor de planta por fecha: en línea, el último dato del historiador; en día cerrado, el cierre del día de planta.
