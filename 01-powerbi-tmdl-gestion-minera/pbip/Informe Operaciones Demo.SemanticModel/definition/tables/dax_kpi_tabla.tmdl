	/// Utilización efectiva del día de planta, promedio de las 4 baterías de hidrociclones.
	measure 'Rd Ciclones UE Día' =
			VAR _d = [Rd Planta Día]
			RETURN CALCULATE ( AVERAGE ( equipos_ciclones[Valor] ), equipos_ciclones[Medicion] = "UE", equipos_ciclones[Fecha] = _d )
		formatString: 0.0
		displayFolder: Tarjetas\Molienda
