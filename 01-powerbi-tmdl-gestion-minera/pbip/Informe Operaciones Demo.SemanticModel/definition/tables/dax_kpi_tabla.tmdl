			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='326' height='118' viewBox='0 0 326 118'>"
			        & "<text x='2' y='48' font-family='Segoe UI Semibold, Segoe UI' font-size='46' font-weight='600' fill='#FFFFFF'>" & _num
			        & "<tspan dx='10' font-family='Segoe UI' font-size='28' font-weight='400' fill='#9AA5B1'>" & _uni & "</tspan></text>"
			        & IF ( _wPlan > 0, "<rect x='2' y='" & FORMAT ( _Y, "0" ) & "' width='" & FORMAT ( _wPlan, "0" ) & "' height='" & FORMAT ( _H, "0" ) & "' rx='4' fill='#3F464D' stroke='#4A545E' stroke-width='1'/>" )
			        & IF ( _wProy > _wReal, "<rect x='" & FORMAT ( _wReal + 2, "0" ) & "' y='" & FORMAT ( _Y + _H / 4, "0" ) & "' width='" & FORMAT ( _wProy - _wReal, "0" ) & "' height='" & FORMAT ( _H / 2, "0" ) & "' rx='" & FORMAT ( _H / 4, "0" ) & "' fill='" & _color & "' fill-opacity='0.55'/>" )
			        & IF ( _wReal > 0, "<rect x='2' y='" & FORMAT ( _Y, "0" ) & "' width='" & FORMAT ( _wReal, "0" ) & "' height='" & FORMAT ( _H, "0" ) & "' rx='4' fill='" & _color & "'/>" )
			        & IF ( _wPlan > 0, "<line x1='" & FORMAT ( _wPlan + 2, "0" ) & "' y1='" & FORMAT ( _Y - 4, "0" ) & "' x2='" & FORMAT ( _wPlan + 2, "0" ) & "' y2='" & FORMAT ( _Y + _H + 4, "0" ) & "' stroke='#E6E6E6' stroke-width='2'/>" )
			        & "<text x='2' y='94' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Real día</text>"
			        & "<text x='2' y='114' font-family='Segoe UI Semibold, Segoe UI' font-size='18' font-weight='600' fill='#E6E6E6'>" & _num & " mil" & "</text>"
			        & "<text x='163' y='94' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Proy. día</text>"
			        & "<text x='163' y='114' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='18' font-weight='600' fill='" & IF ( _curso, "#8EC3EE", "#5D6B7A" ) & "'>" & _vProy & "</text>"
			        & "<text x='324' y='94' text-anchor='end' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Plan día</text>"
			        & "<text x='324' y='114' text-anchor='end' font-family='Segoe UI Semibold, Segoe UI' font-size='18' font-weight='600' fill='#E6E6E6'>" & _vPlan & "</text>"
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: Tarjetas\Mina
		lineageTag: 33b756d3-fefd-490d-8d7a-7bc3b60007f0
		dataCategory: ImageUrl

	/// Tarjeta SVG (data URI) para una visual de tabla con imagen.
	measure 'Rd SVG Plan Movimiento' =
			VAR _d = [Rd Día]
			VAR _ini = DATE ( YEAR ( _d ), MONTH ( _d ), 1 )
			VAR _r =
			    CALCULATE (
			        [Movimiento PM],
			        REMOVEFILTERS ( Calendario ),
			        Calendario[Fecha] >= _ini,
			        Calendario[Fecha] <= _d
			    )
			VAR _pAnt =
			    CALCULATE (
			        [PlanMensual Movimiento mina],
			        REMOVEFILTERS ( Calendario ),
			        Calendario[Fecha] >= _ini,
			        Calendario[Fecha] < _d
			    )
			VAR _pDia = CALCULATE ( [PlanMensual Movimiento mina], REMOVEFILTERS ( Calendario ), Calendario[Fecha] = _d )
			VAR _h = [Rd Horas Transcurridas]
			VAR _p = IF ( NOT ISBLANK ( _pAnt ) || NOT ISBLANK ( _pDia ), _pAnt + _pDia * _h / 24 )
			VAR _rat = IF ( _p > 0 && NOT ISBLANK ( _r ), DIVIDE ( _r, _p ) )
			VAR _c = IF ( ISBLANK ( _rat ), "#5D6B7A", IF ( _rat >= 1, "#2ECC71", IF ( _rat >= 0.9, "#F1C40F", "#E74C3C" ) ) )
			VAR _fmt = IF ( MAX ( _r, _p ) >= 1000000, "#,0", "#,0.0" )
			VAR _nr = IF ( ISBLANK ( _r ), "—", FORMAT ( _r / 1000, _fmt ) )
			VAR _np = IF ( ISBLANK ( _p ), "—", FORMAT ( _p / 1000, _fmt ) )
			VAR _rango = IF ( ISBLANK ( _d ), "", FORMAT ( _ini, "dd-mm" ) & " al " & FORMAT ( _d, "dd-mm" ) )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='326' height='118' viewBox='0 0 326 118'>"
			        & "<circle cx='8' cy='29' r='6' fill='" & _c & "'/>"
			        & "<text x='22' y='34' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Acumulado</text>"
			        & "<text x='22' y='51' font-family='Segoe UI' font-size='12' fill='#7F8C99'>" & _rango & "</text>"
			        & "<text x='324' y='50' text-anchor='end' font-family='Segoe UI Semibold, Segoe UI' font-size='46' font-weight='600' fill='" & IF ( ISBLANK ( _r ), "#5D6B7A", "#FFFFFF" ) & "'>" & _nr
			        & "<tspan dx='10' font-family='Segoe UI' font-size='28' font-weight='400' fill='#9AA5B1'>" & IF ( ISBLANK ( _r ), "s/d", "mil" ) & "</tspan></text>"
			        & "<line x1='2' y1='66' x2='324' y2='66' stroke='#2E3844' stroke-width='1'/>"
			        & "<text x='22' y='93' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Plan mensual</text>"
			        & "<text x='22' y='110' font-family='Segoe UI' font-size='12' fill='#7F8C99'>a la fecha</text>"
			        & "<text x='324' y='109' text-anchor='end' font-family='Segoe UI Semibold, Segoe UI' font-size='46' font-weight='600' fill='" & IF ( ISBLANK ( _p ), "#5D6B7A", "#FFFFFF" ) & "'>" & _np
			        & "<tspan dx='10' font-family='Segoe UI' font-size='28' font-weight='400' fill='#9AA5B1'>" & IF ( ISBLANK ( _p ), "sin plan", "mil" ) & "</tspan></text>"
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: Tarjetas\Mina
		lineageTag: 517216ee-d613-4837-b160-4a4dbf19707f
		dataCategory: ImageUrl

	/// Cascada plan semanal a real de la flota CAEX: disponibilidad, UEBD, rendimiento y horas nominales.
	measure 'Rd SVG Cascada CAEX' =
			VAR _d = [Rd Día]
			VAR _hEq = CALCULATE ( MAXX ( VALUES ( 'Horas Palas Turno'[equipment] ), CALCULATE ( SUM ( 'Horas Palas Turno'[Nominal] ) ) ), Calendario[Fecha] = _d )
			VAR _f = IF ( [Rd Horas Transcurridas] < 24 && _hEq > 0, MIN ( 1, _hEq / 24 ), 1 )
			VAR _ok = CALCULATE ( [PlanSemanal - Horas Nominales CAEX] >= 24 && [PlanSemanal - Disponibilidad CAEX] <= 1 && [PlanSemanal - UEBD CAEX] <= 1, Calendario[Fecha] = _d )
			VAR _p0 = CALCULATE ( [PlanSemanal - movimiento calculado CAEX], Calendario[Fecha] = _d )
			VAR _d10 = CALCULATE ( [Waterfall - Plansemanal dif Disponibilidad], Calendario[Fecha] = _d )
			VAR _d20 = CALCULATE ( [Waterfall - Plansemanal dif UEBD], Calendario[Fecha] = _d )
			VAR _d30 = CALCULATE ( [Waterfall - Plansemanal dif rendimiento], Calendario[Fecha] = _d )
			VAR _d40 = CALCULATE ( [Waterfall - Plansemanal dif hrs nominales], Calendario[Fecha] = _d )
			VAR _p = _f * _p0
			VAR _d1 = _f * _d10
			VAR _d2 = _f * _d20
			VAR _d3 = _f * _d30
			VAR _d4 = _d40 + ( 1 - _f ) * ( _p0 + _d10 + _d20 + _d30 )
			VAR _r = CALCULATE ( [Movimiento PM], Calendario[Fecha] = _d )
			VAR _c0 = _p
			VAR _c1 = _c0 + _d1
			VAR _c2 = _c1 + _d2
			VAR _c3 = _c2 + _d3
			VAR _c4 = _c3 + _d4
			VAR _hi = MAX ( MAX ( MAX ( _p, _r ), MAX ( _c1, _c2 ) ), MAX ( MAX ( _c3, _c4 ), 0 ) )
			VAR _lo = MIN ( MIN ( MIN ( _c1, _c2 ), MIN ( _c3, _c4 ) ), MIN ( _r, 0 ) )
			VAR _rng = IF ( _hi - _lo = 0, 1, _hi - _lo )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='512' height='454' viewBox='0 0 512 454'>"
			        & IF ( ISBLANK ( _p ), "<text x='256' y='184' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Sin plan semanal cargado para el día</text>",
			            IF ( NOT _ok, "<text x='256' y='178' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Plan semanal con error en el origen</text>" & "<text x='256' y='200' text-anchor='middle' font-family='Segoe UI' font-size='13' fill='#7F8C99'>Horas del plan inconsistentes: sin desglose de la diferencia</text>",
			            "<line x1='0' y1='" & FORMAT ( ( 324 - ( ( 0 ) - _lo ) / _rng * 278 ), "0" ) & "' x2='512' y2='" & FORMAT ( ( 324 - ( ( 0 ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#343F4D' stroke-width='1'/>"
			            & "<rect x='17' y='" & FORMAT ( ( 324 - ( ( MAX ( _p, 0 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _p, 0 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _p, 0 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & "#8FA3B8" & "'/>"
			            & "<text x='43' y='" & FORMAT ( ( 324 - ( ( MAX ( _p, 0 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='15' font-weight='600' fill='" & "#FFFFFF" & "'>" & FORMAT ( ( _p ) / 1000, "#,0" ) & "K" & "</text>"
			            & "<line x1='69' y1='" & FORMAT ( ( 324 - ( ( _p ) - _lo ) / _rng * 278 ), "0" ) & "' x2='102' y2='" & FORMAT ( ( 324 - ( ( _p ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#5D6B7A' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<rect x='102' y='" & FORMAT ( ( 324 - ( ( MAX ( _c0, _c1 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _c0, _c1 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _c0, _c1 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & IF ( _d1 <= -500, "#E74C3C", "#2ECC71" ) & "'/>"
			            & "<text x='128' y='" & FORMAT ( ( 324 - ( ( MAX ( _c0, _c1 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='15' font-weight='600' fill='" & IF ( _d1 <= -500, "#E74C3C", "#2ECC71" ) & "'>" & IF ( ABS ( _d1 ) < 500, "0K", IF ( _d1 >= 0, "+", "−" ) & FORMAT ( ( ABS ( _d1 ) ) / 1000, "#,0" ) & "K" ) & "</text>"
			            & "<line x1='154' y1='" & FORMAT ( ( 324 - ( ( _c1 ) - _lo ) / _rng * 278 ), "0" ) & "' x2='187' y2='" & FORMAT ( ( 324 - ( ( _c1 ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#5D6B7A' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<rect x='187' y='" & FORMAT ( ( 324 - ( ( MAX ( _c1, _c2 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _c1, _c2 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _c1, _c2 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & IF ( _d2 <= -500, "#E74C3C", "#2ECC71" ) & "'/>"
			            & "<text x='213' y='" & FORMAT ( ( 324 - ( ( MAX ( _c1, _c2 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='15' font-weight='600' fill='" & IF ( _d2 <= -500, "#E74C3C", "#2ECC71" ) & "'>" & IF ( ABS ( _d2 ) < 500, "0K", IF ( _d2 >= 0, "+", "−" ) & FORMAT ( ( ABS ( _d2 ) ) / 1000, "#,0" ) & "K" ) & "</text>"
			            & "<line x1='239' y1='" & FORMAT ( ( 324 - ( ( _c2 ) - _lo ) / _rng * 278 ), "0" ) & "' x2='273' y2='" & FORMAT ( ( 324 - ( ( _c2 ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#5D6B7A' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<rect x='273' y='" & FORMAT ( ( 324 - ( ( MAX ( _c2, _c3 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _c2, _c3 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _c2, _c3 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & IF ( _d3 <= -500, "#E74C3C", "#2ECC71" ) & "'/>"
			            & "<text x='299' y='" & FORMAT ( ( 324 - ( ( MAX ( _c2, _c3 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='15' font-weight='600' fill='" & IF ( _d3 <= -500, "#E74C3C", "#2ECC71" ) & "'>" & IF ( ABS ( _d3 ) < 500, "0K", IF ( _d3 >= 0, "+", "−" ) & FORMAT ( ( ABS ( _d3 ) ) / 1000, "#,0" ) & "K" ) & "</text>"
			            & "<line x1='325' y1='" & FORMAT ( ( 324 - ( ( _c3 ) - _lo ) / _rng * 278 ), "0" ) & "' x2='358' y2='" & FORMAT ( ( 324 - ( ( _c3 ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#5D6B7A' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<rect x='358' y='" & FORMAT ( ( 324 - ( ( MAX ( _c3, _c4 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _c3, _c4 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _c3, _c4 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & IF ( _d4 <= -500, "#E74C3C", "#2ECC71" ) & "'/>"
			            & "<text x='384' y='" & FORMAT ( ( 324 - ( ( MAX ( _c3, _c4 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='15' font-weight='600' fill='" & IF ( _d4 <= -500, "#E74C3C", "#2ECC71" ) & "'>" & IF ( ABS ( _d4 ) < 500, "0K", IF ( _d4 >= 0, "+", "−" ) & FORMAT ( ( ABS ( _d4 ) ) / 1000, "#,0" ) & "K" ) & "</text>"
			            & "<line x1='410' y1='" & FORMAT ( ( 324 - ( ( _c4 ) - _lo ) / _rng * 278 ), "0" ) & "' x2='443' y2='" & FORMAT ( ( 324 - ( ( _c4 ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#5D6B7A' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<rect x='443' y='" & FORMAT ( ( 324 - ( ( MAX ( _r, 0 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _r, 0 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _r, 0 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & "#8FA3B8" & "'/>"
			            & "<text x='469' y='" & FORMAT ( ( 324 - ( ( MAX ( _r, 0 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='18' font-weight='700' fill='" & "#FFFFFF" & "'>" & FORMAT ( ( _r ) / 1000, "#,0" ) & "K" & "</text>"
			            )
			        )
			        & "<text x='43' y='350' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='#9AA5B1'>Plan sem.</text>"
			        & "<text x='128' y='350' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='#9AA5B1'>Disp.</text>"
			        & "<text x='213' y='350' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='#9AA5B1'>UEBD</text>"
			        & "<text x='299' y='350' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='#9AA5B1'>Rend.</text>"
			        & "<text x='384' y='350' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='#9AA5B1'>Hs nom.</text>"
			        & "<text x='469' y='350' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='#9AA5B1'>Real</text>"
			        & "<g transform='translate(0,362)'>" & [Rd Frag Tabla CAEX] & "</g>"
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: Tarjetas\Mina
		lineageTag: 6f1cb314-259d-4b66-8d60-92ef92af8cfc
		dataCategory: ImageUrl

	/// Cascada plan semanal a real de la flota de carguío.
	measure 'Rd SVG Cascada Carguío' =
			VAR _d = [Rd Día]
			VAR _hEq = CALCULATE ( MAXX ( VALUES ( 'Horas Palas Turno'[equipment] ), CALCULATE ( SUM ( 'Horas Palas Turno'[Nominal] ) ) ), Calendario[Fecha] = _d )
			VAR _f = IF ( [Rd Horas Transcurridas] < 24 && _hEq > 0, MIN ( 1, _hEq / 24 ), 1 )
			VAR _bPD = CALCULATE ( [PlanSemanal - Disponibilidad PALAS], Calendario[Fecha] = _d )
			VAR _bPU = CALCULATE ( [PlanSemanal - UEBD PALAS], Calendario[Fecha] = _d )
			VAR _bPR = CALCULATE ( [PlanSemanal - Rendimiento PALAS], Calendario[Fecha] = _d )
			VAR _bPH = CALCULATE ( [PlanSemanal - Horas Nominales PALAS], Calendario[Fecha] = _d )
			VAR _bRD = CALCULATE ( [Disponibilidad Palas turno], Calendario[Fecha] = _d )
			VAR _bRU = CALCULATE ( [UEBD Palas turno], Calendario[Fecha] = _d )
			VAR _bRT = CALCULATE ( [TPH efectivo Palas Por Turno Palas], Calendario[Fecha] = _d )
			VAR _bNom = CALCULATE ( SUM ( 'Horas Palas Turno'[Nominal] ), Calendario[Fecha] = _d )
			VAR _ok = _bPH >= 24 && _bPD <= 1 && _bPU <= 1
			VAR _p0 = CALCULATE ( [PlanSemanal - movimiento calculado CAEX], Calendario[Fecha] = _d )
			VAR _d10 = ( _bRD * _bPU * _bPR * _bPH ) - ( _bPD * _bPU * _bPR * _bPH )
			VAR _d20 = ( _bRD * _bRU * _bPR * _bPH ) - ( _bRD * _bPU * _bPR * _bPH )
			VAR _d30 = ( _bRD * _bRU * _bRT * _bPH ) - ( _bRD * _bRU * _bPR * _bPH )
			VAR _d40 = ( _bRD * _bRU * _bRT * _bNom ) - ( _bRD * _bRU * _bRT * _bPH )
			VAR _p = _f * _p0
			VAR _d1 = _f * _d10
			VAR _d2 = _f * _d20
			VAR _d3 = _f * _d30
			VAR _d4 = _d40 + ( 1 - _f ) * ( _p0 + _d10 + _d20 + _d30 )
			VAR _r = CALCULATE ( [Movimiento Palas], Calendario[Fecha] = _d )
			VAR _c0 = _p
			VAR _c1 = _c0 + _d1
			VAR _c2 = _c1 + _d2
			VAR _c3 = _c2 + _d3
			VAR _c4 = _c3 + _d4
			VAR _hi = MAX ( MAX ( MAX ( _p, _r ), MAX ( _c1, _c2 ) ), MAX ( MAX ( _c3, _c4 ), 0 ) )
			VAR _lo = MIN ( MIN ( MIN ( _c1, _c2 ), MIN ( _c3, _c4 ) ), MIN ( _r, 0 ) )
			VAR _rng = IF ( _hi - _lo = 0, 1, _hi - _lo )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='512' height='454' viewBox='0 0 512 454'>"
			        & IF ( ISBLANK ( _p ), "<text x='256' y='184' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Sin plan semanal cargado para el día</text>",
			            IF ( NOT _ok, "<text x='256' y='178' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#7F8C99'>Plan semanal con error en el origen</text>" & "<text x='256' y='200' text-anchor='middle' font-family='Segoe UI' font-size='13' fill='#7F8C99'>Horas del plan inconsistentes: sin desglose de la diferencia</text>",
			            "<line x1='0' y1='" & FORMAT ( ( 324 - ( ( 0 ) - _lo ) / _rng * 278 ), "0" ) & "' x2='512' y2='" & FORMAT ( ( 324 - ( ( 0 ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#343F4D' stroke-width='1'/>"
			            & "<rect x='17' y='" & FORMAT ( ( 324 - ( ( MAX ( _p, 0 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _p, 0 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _p, 0 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & "#8FA3B8" & "'/>"
			            & "<text x='43' y='" & FORMAT ( ( 324 - ( ( MAX ( _p, 0 ) ) - _lo ) / _rng * 278 ) - 8, "0" ) & "' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='15' font-weight='600' fill='" & "#FFFFFF" & "'>" & FORMAT ( ( _p ) / 1000, "#,0" ) & "K" & "</text>"
			            & "<line x1='69' y1='" & FORMAT ( ( 324 - ( ( _p ) - _lo ) / _rng * 278 ), "0" ) & "' x2='102' y2='" & FORMAT ( ( 324 - ( ( _p ) - _lo ) / _rng * 278 ), "0" ) & "' stroke='#5D6B7A' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<rect x='102' y='" & FORMAT ( ( 324 - ( ( MAX ( _c0, _c1 ) ) - _lo ) / _rng * 278 ), "0" ) & "' width='52' height='" & FORMAT ( MAX ( ( 324 - ( ( MIN ( _c0, _c1 ) ) - _lo ) / _rng * 278 ) - ( 324 - ( ( MAX ( _c0, _c1 ) ) - _lo ) / _rng * 278 ), 2 ), "0" ) & "' rx='2' fill='" & IF ( _d1 <= -500, "#E74C3C", "#2ECC71" ) & "'/>"
