	/// Consumo específico del SAG del día de planta: kWh por tonelada alimentada (muestras con SAG cargado).
	measure 'Rd SAG kWh t' =
			VAR _ini = [Rd Planta Inicio]
			VAR _fin = [Rd Planta Fin]
			VAR _dz = ROUND ( ( 7 / 24 - MOD ( _ini, 1 ) ) * 24, 0 ) / 24
			VAR _p =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( hist_potencia[timestamp] ), "@kw", CALCULATE ( MAX ( hist_potencia[numeric_value] ) ) ),
			        hist_potencia[nombre_tag] = "SAG.MOTOR.KW",
			        NOT ISBLANK ( hist_potencia[numeric_value] ),
			        hist_potencia[timestamp] > _ini + _dz + 0.0001,
			        hist_potencia[timestamp] <= _fin + _dz + 0.0001
			    )
			VAR _w =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( hist_kpi[timestamp] ), "@tphw", CALCULATE ( MAX ( hist_kpi[numeric_value] ) ) ),
			        hist_kpi[nombre_tag] = "SAG.ALIM.TPH",
			        hist_kpi[timestamp] > _ini - 0.006,
			        hist_kpi[timestamp] < _fin + 0.006,
			        REMOVEFILTERS ( hist_potencia )
			    )
			VAR _x =
			    ADDCOLUMNS (
			        _p,
			        "@tph",
			            VAR _t = hist_potencia[timestamp] - _dz
			            RETURN MAXX ( FILTER ( _w, hist_kpi[timestamp] > _t - 0.005 && hist_kpi[timestamp] < _t + 0.005 ), [@tphw] )
			    )
			VAR _f = FILTER ( _x, [@tph] > 100 && [@kw] > 0 )
			RETURN IF ( NOT ISBLANK ( _ini ), DIVIDE ( SUMX ( _f, [@kw] ), SUMX ( _f, [@tph] ) ) )
		formatString: 0.00
		displayFolder: Tarjetas\Molienda
		lineageTag: 8389f348-3dc9-41cf-abf7-d927712cb444

	/// Leyenda de la ventana del día de mina (08:00 a 08:00).
	measure 'Rd Ventana Mina' =
			VAR _d = [Rd Día]
			RETURN
			    IF (
			        ISBLANK ( _d ),
			        "08:00 → 08:00 h",
			        FORMAT ( _d, "dd-mm" ) & " 08:00 → " & FORMAT ( _d + 1, "dd-mm" ) & " 08:00 h"
			    )
		displayFolder: Tarjetas\Fecha
		lineageTag: 82c2fd5c-c29e-490c-905f-fa363f33da61

	/// Leyenda de la ventana del día de planta (07:00 a 07:00).
	measure 'Rd Ventana Planta' =
			VAR _d = [Rd Planta Día]
			RETURN
			    IF (
			        ISBLANK ( _d ),
			        "07:00 → 07:00 h",
			        FORMAT ( _d, "dd-mm" ) & " 07:00 → " & FORMAT ( _d + 1, "dd-mm" ) & " 07:00 h"
			    )
		displayFolder: Tarjetas\Fecha
		lineageTag: cf468850-3b2d-4a93-a516-d567af0a37bb

	/// Plan del día de la fase en contexto de fila de la dimensión de fases.
	measure 'Rd Fase Plan' =
			VAR _k = SELECTEDVALUE ( 'Dim Fase'[Clave] )
			VAR _d = [Rd Día]
			RETURN
			    IF (
			        NOT ISBLANK ( _k ),
			        CALCULATE ( SUM ( planta_plan_fase[Toneladas] ), planta_plan_fase[Clave] = _k, planta_plan_fase[Fecha] = _d )
			    )
		formatString: #,0
		displayFolder: Tarjetas\Mina
		lineageTag: 9afeebe0-a482-4366-8a6d-77bff2dbe0fe

