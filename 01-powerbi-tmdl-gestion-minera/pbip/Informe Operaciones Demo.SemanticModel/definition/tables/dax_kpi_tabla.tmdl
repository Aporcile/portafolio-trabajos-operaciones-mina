	/// Recuadro de encabezado con la hora de la última actualización del modelo.
	measure 'Rd SVG Última Actualización' =
			VAR _t = MAX ( 'Rd Actualizacion'[Actualizado] )
			VAR _ahora = NOW ()
			VAR _viejo = NOT ISBLANK ( _t ) && INT ( _t ) < INT ( _ahora )
			VAR _txt = IF ( ISBLANK ( _t ), "sin actualizar", IF ( _viejo, FORMAT ( _t, "dd-mm-yyyy" ) & " · ", "" ) & FORMAT ( _t, "hh:nn" ) )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='240' height='44' viewBox='0 0 240 44'>"
			        & "<text x='120' y='15' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='12' font-weight='700' fill='#9AA5B1' letter-spacing='0.5'>ÚLTIMA ACTUALIZACIÓN</text>"
			        & "<text x='120' y='38' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='20' font-weight='700' fill='#FFFFFF'>" & _txt & "</text>"
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: Tarjetas\Encabezado
		lineageTag: df384693-8d87-47bf-9d73-0903d45d6578
		dataCategory: ImageUrl

	/// Fragmento SVG con la tabla real y plan bajo la cascada de la flota CAEX.
	measure 'Rd Frag Tabla CAEX' =
			VAR _d = [Rd Día]
			VAR _hEq = CALCULATE ( MAXX ( VALUES ( 'Horas Palas Turno'[equipment] ), CALCULATE ( SUM ( 'Horas Palas Turno'[Nominal] ) ) ), Calendario[Fecha] = _d )
			VAR _f = IF ( [Rd Horas Transcurridas] < 24 && _hEq > 0, MIN ( 1, _hEq / 24 ), 1 )
			VAR _ok = CALCULATE ( [PlanSemanal - Horas Nominales CAEX] >= 24 && [PlanSemanal - Disponibilidad CAEX] <= 1 && [PlanSemanal - UEBD CAEX] <= 1, Calendario[Fecha] = _d )
			VAR _df = CALCULATE ( [Disponibilidad CAEX], Calendario[Fecha] = _d )
			VAR _dfp = IF ( _ok, CALCULATE ( [PlanSemanal - Disponibilidad CAEX], Calendario[Fecha] = _d ) )
			VAR _ue = CALCULATE ( [UEBD CAEX], Calendario[Fecha] = _d )
			VAR _uep = IF ( _ok, CALCULATE ( [PlanSemanal - UEBD CAEX], Calendario[Fecha] = _d ) )
			VAR _re = CALCULATE ( [TPH efectivo CAEX REV], Calendario[Fecha] = _d )
			VAR _rep = IF ( _ok, CALCULATE ( [PlanSemanal - Rendimiento CAEX], Calendario[Fecha] = _d ) )
			VAR _hn = CALCULATE ( [Hr nominales], Calendario[Fecha] = _d )
			VAR _hnp = IF ( _ok, _f * CALCULATE ( [PlanSemanal - Horas Nominales CAEX], Calendario[Fecha] = _d ) )
			VAR _t = CALCULATE ( [Movimiento PM], Calendario[Fecha] = _d )
			VAR _tp = _f * CALCULATE ( [PlanSemanal - movimiento calculado CAEX], Calendario[Fecha] = _d )
			RETURN
			    "<line x1='0' y1='0' x2='512' y2='0' stroke='#2E3844' stroke-width='1'/>"
			        & "<text x='43' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='14' font-weight='600' fill='#9AA5B1'>Real</text>"
			        & "<text x='128' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _df ) || ISBLANK ( _dfp ), "#E6E6E6", IF ( ROUND ( _df, 3 ) >= ROUND ( _dfp, 3 ), "#2ECC71", IF ( _df >= 0.9 * _dfp, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _df ), "—", FORMAT ( _df, "0.0 %" ) ) & "</text>"
			        & "<text x='213' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _ue ) || ISBLANK ( _uep ), "#E6E6E6", IF ( ROUND ( _ue, 3 ) >= ROUND ( _uep, 3 ), "#2ECC71", IF ( _ue >= 0.9 * _uep, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _ue ), "—", FORMAT ( _ue, "0.0 %" ) ) & "</text>"
			        & "<text x='299' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _re ) || ISBLANK ( _rep ), "#E6E6E6", IF ( ROUND ( _re, 1 ) >= ROUND ( _rep, 0 ), "#2ECC71", IF ( _re >= 0.9 * _rep, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _re ), "—", FORMAT ( _re, "#,0.0" ) & "<tspan font-size='12' fill='#7F8C99'> t/h</tspan>" ) & "</text>"
			        & "<text x='384' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _hn ) || ISBLANK ( _hnp ), "#E6E6E6", IF ( ROUND ( _hn, 0 ) >= ROUND ( _hnp, 0 ), "#2ECC71", IF ( _hn >= 0.9 * _hnp, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _hn ), "—", FORMAT ( _hn, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> h</tspan>" ) & "</text>"
			        & "<text x='469' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _t ) || ISBLANK ( _tp ), "#E6E6E6", IF ( ROUND ( _t, 0 ) >= ROUND ( _tp, 0 ), "#2ECC71", IF ( _t >= 0.9 * _tp, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _t ), "—", FORMAT ( _t, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> t</tspan>" ) & "</text>"
			        & "<line x1='0' y1='42' x2='512' y2='42' stroke='#2E3844' stroke-width='1'/>"
			        & "<text x='43' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='14' font-weight='600' fill='#9AA5B1'>Plan</text>"
			        & "<text x='128' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _dfp ), "—", FORMAT ( _dfp, "0.0 %" ) ) & "</text>"
			        & "<text x='213' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _uep ), "—", FORMAT ( _uep, "0.0 %" ) ) & "</text>"
			        & "<text x='299' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _rep ), "—", FORMAT ( _rep, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> t/h</tspan>" ) & "</text>"
			        & "<text x='384' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _hnp ), "—", FORMAT ( _hnp, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> h</tspan>" ) & "</text>"
			        & "<text x='469' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _tp ), "—", FORMAT ( _tp, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> t</tspan>" ) & "</text>"
		displayFolder: Tarjetas\Mina
		lineageTag: 272d3ac3-a7eb-4372-bcd8-681ce1c7851d

	/// Fragmento SVG con la tabla real y plan bajo la cascada de la flota de carguío.
	measure 'Rd Frag Tabla Carguío' =
			VAR _d = [Rd Día]
			VAR _hEq = CALCULATE ( MAXX ( VALUES ( 'Horas Palas Turno'[equipment] ), CALCULATE ( SUM ( 'Horas Palas Turno'[Nominal] ) ) ), Calendario[Fecha] = _d )
			VAR _f = IF ( [Rd Horas Transcurridas] < 24 && _hEq > 0, MIN ( 1, _hEq / 24 ), 1 )
			VAR _ok = CALCULATE ( [PlanSemanal - Horas Nominales PALAS] >= 24 && [PlanSemanal - Disponibilidad PALAS] <= 1 && [PlanSemanal - UEBD PALAS] <= 1, Calendario[Fecha] = _d )
			VAR _df = CALCULATE ( [Disponibilidad Palas turno], Calendario[Fecha] = _d )
			VAR _dfp = IF ( _ok, CALCULATE ( [PlanSemanal - Disponibilidad PALAS], Calendario[Fecha] = _d ) )
			VAR _ue = CALCULATE ( [UEBD Palas turno], Calendario[Fecha] = _d )
			VAR _uep = IF ( _ok, CALCULATE ( [PlanSemanal - UEBD PALAS], Calendario[Fecha] = _d ) )
			VAR _re = CALCULATE ( [TPH efectivo Palas Por Turno Palas], Calendario[Fecha] = _d )
			VAR _rep = IF ( _ok, CALCULATE ( [PlanSemanal - Rendimiento Palas], Calendario[Fecha] = _d ) )
			VAR _hn = CALCULATE ( SUM ( 'Horas Palas Turno'[Nominal] ), Calendario[Fecha] = _d )
			VAR _hnp = IF ( _ok, _f * CALCULATE ( [PlanSemanal - Horas Nominales PALAS], Calendario[Fecha] = _d ) )
			VAR _t = CALCULATE ( [Movimiento Palas], Calendario[Fecha] = _d )
			VAR _tp = _f * CALCULATE ( [PlanSemanal - movimiento calculado CAEX], Calendario[Fecha] = _d )
			RETURN
			    "<line x1='0' y1='0' x2='512' y2='0' stroke='#2E3844' stroke-width='1'/>"
			        & "<text x='43' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='14' font-weight='600' fill='#9AA5B1'>Real</text>"
			        & "<text x='128' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _df ) || ISBLANK ( _dfp ), "#E6E6E6", IF ( ROUND ( _df, 3 ) >= ROUND ( _dfp, 3 ), "#2ECC71", IF ( _df >= 0.9 * _dfp, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _df ), "—", FORMAT ( _df, "0.0 %" ) ) & "</text>"
			        & "<text x='213' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _ue ) || ISBLANK ( _uep ), "#E6E6E6", IF ( ROUND ( _ue, 3 ) >= ROUND ( _uep, 3 ), "#2ECC71", IF ( _ue >= 0.9 * _uep, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _ue ), "—", FORMAT ( _ue, "0.0 %" ) ) & "</text>"
			        & "<text x='299' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _re ) || ISBLANK ( _rep ), "#E6E6E6", IF ( ROUND ( _re, 1 ) >= ROUND ( _rep, 0 ), "#2ECC71", IF ( _re >= 0.9 * _rep, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _re ), "—", FORMAT ( _re, "#,0.0" ) & "<tspan font-size='12' fill='#7F8C99'> t/h</tspan>" ) & "</text>"
			        & "<text x='384' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _hn ) || ISBLANK ( _hnp ), "#E6E6E6", IF ( ROUND ( _hn, 0 ) >= ROUND ( _hnp, 0 ), "#2ECC71", IF ( _hn >= 0.9 * _hnp, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _hn ), "—", FORMAT ( _hn, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> h</tspan>" ) & "</text>"
			        & "<text x='469' y='28' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='17' font-weight='600' fill='" & IF ( ISBLANK ( _t ) || ISBLANK ( _tp ), "#E6E6E6", IF ( ROUND ( _t, 0 ) >= ROUND ( _tp, 0 ), "#2ECC71", IF ( _t >= 0.9 * _tp, "#F1C40F", "#E74C3C" ) ) ) & "'>" & IF ( ISBLANK ( _t ), "—", FORMAT ( _t, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> t</tspan>" ) & "</text>"
			        & "<line x1='0' y1='42' x2='512' y2='42' stroke='#2E3844' stroke-width='1'/>"
			        & "<text x='43' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='14' font-weight='600' fill='#9AA5B1'>Plan</text>"
			        & "<text x='128' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _dfp ), "—", FORMAT ( _dfp, "0.0 %" ) ) & "</text>"
			        & "<text x='213' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _uep ), "—", FORMAT ( _uep, "0.0 %" ) ) & "</text>"
			        & "<text x='299' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _rep ), "—", FORMAT ( _rep, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> t/h</tspan>" ) & "</text>"
			        & "<text x='384' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _hnp ), "—", FORMAT ( _hnp, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> h</tspan>" ) & "</text>"
			        & "<text x='469' y='68' text-anchor='middle' font-family='Segoe UI Semibold, Segoe UI' font-size='16' font-weight='600' fill='" & "#9AA5B1" & "'>" & IF ( ISBLANK ( _tp ), "—", FORMAT ( _tp, "#,0" ) & "<tspan font-size='12' fill='#7F8C99'> t</tspan>" ) & "</text>"
		displayFolder: Tarjetas\Mina
