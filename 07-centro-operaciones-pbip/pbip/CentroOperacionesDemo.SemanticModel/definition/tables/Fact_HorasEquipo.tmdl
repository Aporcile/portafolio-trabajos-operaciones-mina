table Fact_HorasEquipo
	lineageTag: 7a77138c-8900-45ef-9cac-88e53d177eeb

	measure 'Tonelaje Total Turno' =
			
			CALCULATE(
			    SUM(Fact_HorasEquipo[Tonelaje]),
			    Fact_HorasEquipo[Tipo Equipo] = "Truck"
			)
		lineageTag: 268c04c7-2bac-4b14-bbaf-41f0308c4404

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Disponibilidad CAEX' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Disponibles]), Fact_HorasEquipo[Tipo Equipo] = "Truck"),
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Nominales]), Fact_HorasEquipo[Tipo Equipo] = "Truck"),
			    0
			)
		lineageTag: 4328e1e3-4e81-4b3f-8b46-c720b5950844

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Utilizacion CAEX' = ```
			
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Operativas]), Fact_HorasEquipo[Tipo Equipo] = "Truck"),
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Disponibles]), Fact_HorasEquipo[Tipo Equipo] = "Truck")
			)
			
			```
		lineageTag: 35dd62a4-66c5-4da3-a964-a4dd0f9b2a42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'UE CAEX' = ```
			
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Efectivas]), Fact_HorasEquipo[Tipo Equipo] = "Truck"),
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Disponibles]), Fact_HorasEquipo[Tipo Equipo] = "Truck")
			)
			
			
			```
		lineageTag: fa360566-a121-4912-a8c5-ae2fed5a93b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Camiones Operando' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_HorasEquipo[Equipo]),
			    Fact_HorasEquipo[Tipo Equipo] = "Truck",
			    Fact_HorasEquipo[Horas Operativas] > 0
			)
			
			```
		formatString: 0
		lineageTag: c4077dc1-0816-4b79-b902-6c6e963a6896

	measure 'Rendimiento Carguio t/h' = ```
			
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo[Tonelaje]), Fact_HorasEquipo[Tipo Equipo] IN {"Shovel", "Loader"}),
			    CALCULATE(SUM(Fact_HorasEquipo[Horas Efectivas]), Fact_HorasEquipo[Tipo Equipo] IN {"Shovel", "Loader"}),
			    0
			)
			
			```
		lineageTag: f398e81f-926c-4383-9017-1318763e5abd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Color Rendimiento Carguio' = ```
			
			VAR Real = [Rendimiento Carguio t/h]
			VAR Plan = [Rendimiento Carguio Plan]
			RETURN
			    IF(ISBLANK(Real) || ISBLANK(Plan), "#8FA3B8",
			        IF(Real >= Plan, "#00C853", "#8FA3B8"))
			
			```
		lineageTag: efc95553-cb2a-4ede-bb79-9fff9841a203

	measure 'Proyeccion Ampliacion' =
			VAR ExtraidoAcumulado =
			    CALCULATE(
			        SUM(Fact_HorasEquipo[Material Extraido]),
			        Fact_HorasEquipo[Tipo Equipo] = "Truck"
			    )
			VAR HorasPeriodo = 12 * COUNTROWS(VALUES(Dim_Turno[Turno]))
			RETURN
			    DIVIDE(ExtraidoAcumulado, [Horas Dia Con Datos]) * HorasPeriodo
		lineageTag: 138e956a-5b1c-4db7-850e-a8a42a3f3ce9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Proyeccion Mov Mina' =
			VAR MovimientoAcumulado =
			    CALCULATE(
			        SUM(Fact_HorasEquipo[Movimiento Total]),
			        Fact_HorasEquipo[Tipo Equipo] = "Truck"
			    )
			VAR HorasPeriodo = 12 * COUNTROWS(VALUES(Dim_Turno[Turno]))
			RETURN
			    DIVIDE(MovimientoAcumulado, [Horas Dia Con Datos]) * HorasPeriodo
		lineageTag: 96e884e7-0104-41c3-99a6-c9ce95e90e04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Palas Operando' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_HorasEquipo[Equipo]),
			    Fact_HorasEquipo[Tipo Equipo] = "Shovel",
			    Fact_HorasEquipo[Horas Operativas] > 0
			)
			
			```
		formatString: 0
		lineageTag: c1e060d5-a5c7-463f-b8ec-4eb2aa71665a

	measure 'Perforadoras Operando' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_HorasEquipo[Equipo]),
			    Fact_HorasEquipo[Tipo Equipo] = "Drill",
			    Fact_HorasEquipo[Horas Operativas] > 0
			)
			
			```
		formatString: 0
		lineageTag: 13500556-e2c8-4d54-b285-802c832bdc13

	measure 'Cargadores Operando' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_HorasEquipo[Equipo]),
			    Fact_HorasEquipo[Tipo Equipo] = "Loader",
			    Fact_HorasEquipo[Horas Operativas] > 0
			)
			
			```
		formatString: 0
		lineageTag: 8961b62a-fd65-4526-a26d-b0b56f91e442

