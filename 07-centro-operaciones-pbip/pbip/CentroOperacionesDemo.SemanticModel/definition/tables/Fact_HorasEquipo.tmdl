	column Hora_Orden = ```
			
			VAR InicioTurno = IF(Fact_HorasEquipo[Turno] = "A", 8, 20)
			VAR HoraAbsoluta = MOD(InicioTurno + Fact_HorasEquipo[Hora], 24)
			RETURN
			    MOD(HoraAbsoluta + 16, 24)
			
			```
		formatString: 0
		lineageTag: 3133049d-469b-45f1-9780-0a2892fdf8d8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column HoraTurno = ```
			Fact_HorasEquipo[Hora] + 1
			
			```
		formatString: 0
		lineageTag: 0d233938-c36b-43f2-b13c-2bdadb5199dc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Posicion 1-24 en el dia operacional (Hora = indice 0-11 dentro del turno).
	column Orden_Hora_Dia =
			VAR H = Fact_HorasEquipo[Hora]
			RETURN
			    IF(H >= 0 && H <= 11, SWITCH(Fact_HorasEquipo[Turno], "A", H + 1, "B", H + 13))
		isHidden
		formatString: 0
		lineageTag: 37b88baf-7183-40a5-bb5e-185f00494305
		summarizeBy: none

	partition Fact_HorasEquipo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_horas_equipo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Turno", type text}, {"Hora", Int64.Type}, {"Tipo Equipo", type text}, {"Equipo", type text}, {"Flota", type text}, {"Horas Nominales", type number}, {"Horas Operativas", type number}, {"Horas Efectivas", type number}, {"Horas PO Espera", type number}, {"Horas PO Cola", type number}, {"Horas PO Totales", type number}, {"Horas Demora No Programada", type number}, {"Horas Demora Programada", type number}, {"Horas Reserva", type number}, {"Horas Disponibles", type number}, {"Horas Mantencion Programada", type number}, {"Horas Mantencion No Programada", type number}, {"Tonelaje", type number}, {"Material Extraido", type number}, {"Material Remanejo", type number}, {"Movimiento Total", type number}, {"Metros Perforados", type number}, {"Disponibilidad", type number}, {"Utilizacion", type number}, {"UE", type number}, {"OEE_Horas", type number}, {"Rendimiento", type number}}, "en-US"),
				    // Ventana de historia: solo las filas de los ultimos DiasHistoria dias respecto de FechaReferencia.
				    Ventana = Table.SelectRows(Tipos, each Date.From([Fecha]) >= Date.AddDays(FechaReferencia, -DiasHistoria))
				in
				    Ventana

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

