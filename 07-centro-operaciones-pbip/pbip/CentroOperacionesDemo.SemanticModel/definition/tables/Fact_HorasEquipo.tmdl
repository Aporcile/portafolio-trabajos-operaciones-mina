	/// Horas (de 24) del dia operacional con movimiento de camiones mayor a 0.
	measure 'Horas Dia Con Datos' =
			VAR TablaHoras =
			    ADDCOLUMNS(
			        VALUES(Fact_HorasEquipo[Orden_Hora_Dia]),
			        "@Mov",
			            CALCULATE(
			                SUM(Fact_HorasEquipo[Movimiento Total]),
			                Fact_HorasEquipo[Tipo Equipo] = "Truck"
			            )
			    )
			RETURN
			    COUNTROWS(FILTER(TablaHoras, NOT ISBLANK(Fact_HorasEquipo[Orden_Hora_Dia]) && [@Mov] > 0))
		formatString: 0
		lineageTag: 7caf3603-14d8-4af1-abe2-82c9398e0165

	measure 'Disponibilidad Carguio' =
			DIVIDE(
