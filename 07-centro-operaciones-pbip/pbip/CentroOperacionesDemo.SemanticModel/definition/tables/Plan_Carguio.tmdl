				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Equipo", type text}, {"Horas Disponibles Plan", type number}, {"Horas Efectivas Plan", type number}, {"Horas Operativas Plan", type number}, {"Toneladas Plan", type number}, {"Horas Nominales Plan", type number}}, "en-US")
