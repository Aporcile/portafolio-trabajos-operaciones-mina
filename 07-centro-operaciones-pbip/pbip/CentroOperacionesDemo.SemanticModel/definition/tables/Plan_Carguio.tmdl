table Plan_Carguio
	lineageTag: bbddfdb8-fb9b-4f15-b14a-6a743a375c28

	measure 'Rendimiento Carguio Plan' = ```
			
			VAR EquiposVisibles = VALUES(Fact_HorasEquipo[Equipo])
			RETURN
			    CALCULATE(
			        DIVIDE(SUM(Plan_Carguio[Toneladas Plan]), SUM(Plan_Carguio[Horas Efectivas Plan]), 0),
			        TREATAS(EquiposVisibles, Plan_Carguio[Equipo])
			    )
			
			```
		lineageTag: 18028d5c-62cf-476f-92fd-f863702a5d98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Utilizacion Carguio Plan' = ```
			
			VAR EquiposVisibles = VALUES(Fact_HorasEquipo[Equipo])
			RETURN
			    CALCULATE(
			        DIVIDE(SUM(Plan_Carguio[Horas Operativas Plan]), SUM(Plan_Carguio[Horas Disponibles Plan]), 0),
			        TREATAS(EquiposVisibles, Plan_Carguio[Equipo])
			    )
			
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c6cea28d-a6a3-4e99-9b64-fb9b764e7642

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Disponibilidad Carguio Plan' =
			VAR EquiposVisibles = VALUES(Fact_HorasEquipo[Equipo])
			RETURN
			    CALCULATE(
			        DIVIDE(SUM(Plan_Carguio[Horas Disponibles Plan]), SUM(Plan_Carguio[Horas Nominales Plan]), 0),
			        TREATAS(EquiposVisibles, Plan_Carguio[Equipo])
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 9dcb6b77-1356-47b6-8218-c6a4da92c49f

	measure 'UEBD Carguio Plan' =
			VAR EquiposVisibles = VALUES(Fact_HorasEquipo[Equipo])
			RETURN
			    CALCULATE(
			        DIVIDE(SUM(Plan_Carguio[Horas Efectivas Plan]), SUM(Plan_Carguio[Horas Disponibles Plan]), 0),
			        TREATAS(EquiposVisibles, Plan_Carguio[Equipo])
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b662438c-6d81-48be-aa50-cc59ff325ac8

	measure 'Disponibilidad Pala Plan' =
			CALCULATE(
			    DIVIDE(SUM(Plan_Carguio[Horas Disponibles Plan]), SUM(Plan_Carguio[Horas Nominales Plan]), 0),
			    FILTER(Plan_Carguio, LEFT(Plan_Carguio[Equipo], 1) = "P")
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8a3d8a86-3253-4b97-a96d-1435eca1bfd7

	measure 'UEBD Pala Plan' =
			CALCULATE(
			    DIVIDE(SUM(Plan_Carguio[Horas Efectivas Plan]), SUM(Plan_Carguio[Horas Disponibles Plan]), 0),
			    FILTER(Plan_Carguio, LEFT(Plan_Carguio[Equipo], 1) = "P")
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b8d65985-5be0-42a0-ac66-ab2c32e9adcf

	measure 'Rendimiento Pala Plan' =
			CALCULATE(
			    DIVIDE(SUM(Plan_Carguio[Toneladas Plan]), SUM(Plan_Carguio[Horas Efectivas Plan]), 0),
			    FILTER(Plan_Carguio, LEFT(Plan_Carguio[Equipo], 1) = "P")
			)
		formatString: #,0.0
		lineageTag: 4837e991-57a3-4620-ad10-27e5443eb9cf

