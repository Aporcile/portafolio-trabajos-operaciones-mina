	partition Fact_Ciclos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_ciclos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"DiaOperativo", type datetime}, {"id_registro_ciclo", Int64.Type}, {"time", type datetime}, {"shift_id", Int64.Type}, {"shift", type text}, {"crew_id", Int64.Type}, {"crew", type text}, {"truck_id", Int64.Type}, {"TruckName", type text}, {"TruckFleet", type text}, {"shovel_id", Int64.Type}, {"ShovelName", type text}, {"ShovelFleet", type text}, {"grade_id", Int64.Type}, {"GradeName", type text}, {"material_id", Int64.Type}, {"MaterialName", type text}, {"dump_id", Int64.Type}, {"Dump_LocationType", type text}, {"DumpName", type text}, {"blast_id", Int64.Type}, {"Blast_LocationType", type text}, {"BlastName", type text}, {"latitude", Int64.Type}, {"longitude", Int64.Type}, {"elevation", Int64.Type}, {"northing", type number}, {"easting", type number}, {"l_elevation", type number}, {"by_dispatcher", type logical}, {"assignment_reason_id", Int64.Type}, {"asignacion_motivo_tipo", type text}, {"assigned_shovel_id", Int64.Type}, {"asignacion_pala_tipo", type text}, {"truck_operator_id", Int64.Type}, {"TruckOpName", type text}, {"TruckOpPayNumber", Int64.Type}, {"shovel_operator_id", Int64.Type}, {"ShohvelOpName", type text}, {"ShovelOpPayNumber", Int64.Type}, {"time_depart", type datetime}, {"time_arrive", type datetime}, {"time_spotting", type datetime}, {"time_spotted", type datetime}, {"expected_time", Int64.Type}, {"distance", Int64.Type}, {"efh", Int64.Type}, {"lift_down", Int64.Type}, {"lift_up", Int64.Type}, {"lift_distance_down", Int64.Type}, {"lift_distance_up", Int64.Type}, {"start_location_id", Int64.Type}, {"end_location_id", Int64.Type}, {"has_payload", type logical}, {"activity_id", Int64.Type}, {"time_full", type datetime}, {"time_empty", type datetime}, {"load_count", Int64.Type}, {"cycle_count", Int64.Type}, {"material_tonnage", type number}, {"payload", type number}, {"payload_count", Int64.Type}, {"distance_empty", Int64.Type}, {"distance_loaded", Int64.Type}, {"inactive_time", Int64.Type}, {"traveling_time", Int64.Type}, {"waiting_time", Int64.Type}, {"spotting_time", Int64.Type}, {"loading_time", Int64.Type}, {"hauling_time", Int64.Type}, {"queued_time", Int64.Type}, {"backing_time", Int64.Type}, {"tipping_time", Int64.Type}, {"traveling_efh", Int64.Type}, {"hauling_efh", Int64.Type}, {"swing_times", type text}, {"swing_angles", type text}, {"loading_seconds", Int64.Type}, {"spotting_seconds", Int64.Type}, {"waiting_seconds", Int64.Type}, {"extraload", Int64.Type}, {"login_dispatcher", type text}, {"PO_CAEX_CARGA_MIN", type number}, {"PO_CAEX_DESCARGA_MIN", type number}, {"PO_TOTAL_CAEX_MIN", type number}, {"PO_CARGUIO_ESPERANDO_CAEX_MIN", type number}}, "en-US"),
				    // Ventana de historia: solo las filas de los ultimos DiasHistoria dias respecto de FechaReferencia.
				    Ventana = Table.SelectRows(Tipos, each Date.From([DiaOperativo]) >= Date.AddDays(FechaReferencia, -DiasHistoria))
				in
				    Ventana

