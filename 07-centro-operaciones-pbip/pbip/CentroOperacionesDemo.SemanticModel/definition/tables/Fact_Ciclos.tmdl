table Fact_Ciclos
	lineageTag: a076c522-d044-4289-b180-a1951a821c25

	measure 'Tiempo Ciclo Promedio Min' = ```
			
			AVERAGEX(
			    Fact_Ciclos,
			    (
			        Fact_Ciclos[traveling_time] + Fact_Ciclos[waiting_time] + Fact_Ciclos[loading_time] +
			        Fact_Ciclos[hauling_time] + Fact_Ciclos[queued_time] + Fact_Ciclos[tipping_time]
			    ) / 60
			)
			
			```
		formatString: 0.0
		lineageTag: 195aa6cf-2cc0-4b1b-9fee-e81aaed3899f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tiempo Ciclo Ultima Hora' = ```
			
			VAR UltimoInstante = MAX(Fact_Ciclos[time_empty])
			RETURN
			    IF(
			        ISBLANK(UltimoInstante),
			        BLANK(),
			        CALCULATE(
			            [Tiempo Ciclo Promedio Min],
			            Fact_Ciclos[time_empty] > UltimoInstante - TIME(1, 0, 0)
			        )
			    )
			
			```
		lineageTag: 04de8e3b-d63f-474b-976a-603c02e44c72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Desviacion Ciclo Minutos' = ```
			
			[Tiempo Ciclo Ultima Hora] - [Tiempo Ciclo Promedio Min]
			
			```
		formatString: 0.0
		lineageTag: 2d24ca73-a838-4438-8960-659c28ca5f5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Destino Actual' = ```
			
			IF(
			    NOT ISINSCOPE(Dim_Carguio[Equipo]),
			    BLANK(),
			    VAR TablaOrdenada =
			        TOPN(
			            1,
			            Fact_Ciclos,
			            Fact_Ciclos[time],
			            DESC
			        )
			    RETURN
			        MAXX(TablaOrdenada, Fact_Ciclos[DumpName])
			)
			
			```
		lineageTag: b4132e98-04b6-49de-bd33-5c204ce46016

