table Fact_GPS
	lineageTag: 7292bbe9-f183-439b-a37a-3c33a0b4b037

	/// Filtro del mapa: 1 si el punto debe dibujarse. Con una hora seleccionada muestra esa hora; sin hora, la ultima hora con datos del dia elegido.
	measure 'Mostrar Punto GPS' =
			VAR HayHoraElegida = ISCROSSFILTERED(Dim_Hora_Operacional[Orden_Hora_Dia])
			-- Fechas que el usuario dejo elegidas (ALL(Fact_GPS) las borra, por eso se guardan antes)
			VAR FechasElegidas = VALUES(Dim_Tiempo[Fecha])
			-- Sin hora elegida: ultima hora con datos del ultimo dia elegido (hoy = la hora en curso)
			VAR UltimaFechaConDatos =
			    CALCULATE(
			        MAX(Fact_GPS[Fecha]),
			        ALL(Fact_GPS),
			        ALL(Dim_Hora_Operacional),
			        FechasElegidas
			    )
			VAR UltimaHoraConDatos =
			    CALCULATE(
			        MAX(Fact_GPS[Orden_Hora_Dia]),
			        ALL(Fact_GPS),
			        ALL(Dim_Hora_Operacional),
			        FechasElegidas,
			        Fact_GPS[Fecha] = UltimaFechaConDatos
			    )
			VAR FilasVisibles = COUNTROWS(Fact_GPS)
			VAR FilasEnUltimaHora =
			    CALCULATE(
			        COUNTROWS(Fact_GPS),
			        Fact_GPS[Fecha] = UltimaFechaConDatos,
			        Fact_GPS[Orden_Hora_Dia] = UltimaHoraConDatos
			    )
			RETURN
			    IF(
			        HayHoraElegida,
			        IF(FilasVisibles > 0, 1),
			        IF(FilasEnUltimaHora > 0, 1)
			    )
		isHidden
		lineageTag: 148b5726-b424-420c-9ffd-e8a5dcf3a3b3

