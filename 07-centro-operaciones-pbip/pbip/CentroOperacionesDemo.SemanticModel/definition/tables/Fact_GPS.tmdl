	partition Fact_GPS = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_gps.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Turno", type text}, {"Equipo", type text}, {"FechaHora", type datetime}, {"Latitud", type number}, {"Longitud", type number}, {"Velocidad km/h", type number}, {"Fecha", type datetime}, {"Orden_Hora_Dia", Int64.Type}}, "en-US"),
				    // Ventana de historia: solo las filas de los ultimos DiasHistoriaGPS dias respecto de FechaReferencia.
				    Ventana = Table.SelectRows(Tipos, each Date.From([Fecha]) >= Date.AddDays(FechaReferencia, -DiasHistoriaGPS)),
				    #"Rango agregado" = Table.AddColumn(Ventana, "Rango_Velocidad", each if [#"Velocidad km/h"] <= 5 then "Bajo (0-5)" else "Normal (>5)", type text),
				    #"Latitud en grados" = Table.AddColumn(#"Rango agregado", "Lat_Grados", each [Latitud] / 3600000, type number),
				    #"Longitud en grados" = Table.AddColumn(#"Latitud en grados", "Long_Grados", each [Longitud] / 3600000, type number)
				in
				    #"Longitud en grados"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

