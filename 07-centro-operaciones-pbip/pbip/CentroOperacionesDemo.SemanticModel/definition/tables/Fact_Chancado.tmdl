	partition Fact_Chancado = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_chancado.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Turno", type text}, {"Equipo_Carguio", type text}, {"CAEX", type text}, {"Ley", type text}, {"Origen", type text}, {"Destino", type text}, {"Material", type text}, {"Tonelaje", type number}, {"Viajes", Int64.Type}, {"CuT", type number}, {"Cusc", type text}, {"Cuas", type text}, {"CuS", type text}, {"Cuins", type text}, {"Mo", type text}, {"rec_cu_1", type text}, {"rec_cu_2", type text}, {"zona_1", type text}, {"zona_2", type text}, {"dens", type text}, {"cucns", type text}}, "en-US"),
				    // Ventana de historia: solo las filas de los ultimos DiasHistoria dias respecto de FechaReferencia.
				    Ventana = Table.SelectRows(Tipos, each Date.From([Fecha]) >= Date.AddDays(FechaReferencia, -DiasHistoria))
				in
				    Ventana

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

