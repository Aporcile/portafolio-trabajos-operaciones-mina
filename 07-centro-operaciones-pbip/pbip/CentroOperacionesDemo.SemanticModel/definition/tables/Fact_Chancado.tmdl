table Fact_Chancado
	lineageTag: 0e64c9ec-2a57-462e-963f-373a4551eddf

	measure 'Tonelaje Chancado' =
			
			SUM(Fact_Chancado[Tonelaje])
		lineageTag: c9f639f1-d286-411e-bf05-2c6fc929c89c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ley Alimentacion' = ```
			
			DIVIDE(
			    SUMX(Fact_Chancado, Fact_Chancado[CuT] * Fact_Chancado[Tonelaje]),
			    SUM(Fact_Chancado[Tonelaje])
			)
			
			```
		lineageTag: b90eef06-76ed-413f-9f91-5288fa1322cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Color_Ley_Alimentacion = ```
			
			VAR Real = [Ley Alimentacion]
			VAR Plan = [Plan Ley Alimentacion]
			RETURN
			    IF(ISBLANK(Real) || ISBLANK(Plan), "#E6ECF2",
			        IF(Real >= Plan, "#00C853", "#FF5C5C"))
			
			```
		lineageTag: 0f739397-218d-412c-92b3-bf84297e1ff7

	/// Plan de ley de alimentacion (% CuT) del dia operacional, tomada del plan semanal (Plan_Semanal_Chancador).
	measure 'Plan Ley Alimentacion' =
			VAR FechaSel = [Fecha_Efectiva]
			RETURN
			    CALCULATE(
			        AVERAGE(Plan_Semanal_Chancador[Plan Ley CuT]),
			        Plan_Semanal_Chancador[Fecha] = FechaSel
			    )
		formatString: 0.00"%"
		lineageTag: b800ff2c-5cda-43e4-ad79-f84463984b6f

