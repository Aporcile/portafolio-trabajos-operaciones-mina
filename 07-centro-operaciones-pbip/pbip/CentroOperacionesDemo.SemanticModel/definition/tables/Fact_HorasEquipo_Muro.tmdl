	column Orden_Hora_Dia =
			VAR H = Fact_HorasEquipo_Muro[Hora]
			RETURN
			    IF(H >= 0 && H <= 11, SWITCH(Fact_HorasEquipo_Muro[Turno], "A", H + 1, "B", H + 13))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 17a4efc6-e31e-4604-96b0-6523e672c16c
		summarizeBy: none

	partition Fact_HorasEquipo_Muro = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_horas_equipo_muro.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Turno", type text}, {"Hora", Int64.Type}, {"Equipo", type text}, {"Horas Operativas", type number}, {"Tipo Equipo", type text}, {"Flota", type text}, {"Horas Nominales", type number}, {"Horas Efectivas", type number}, {"Horas Disponibles", type number}, {"Horas PO Totales", type number}, {"Horas Demora No Programada", type number}, {"Horas Demora Programada", type number}, {"Horas Reserva", type number}, {"Horas Mantencion Programada", type number}, {"Horas Mantencion No Programada", type number}, {"Tonelaje", type number}, {"Material Extraido", type number}, {"Material Remanejo", type number}, {"Movimiento Total", type number}}, "en-US"),
				    // Ventana de historia: solo las filas de los ultimos DiasHistoria dias respecto de FechaReferencia.
				    Ventana = Table.SelectRows(Tipos, each Date.From([Fecha]) >= Date.AddDays(FechaReferencia, -DiasHistoria))
				in
				    Ventana

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

