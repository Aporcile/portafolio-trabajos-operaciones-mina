table Fact_HorasEquipo_Muro
	lineageTag: 9f1ab957-e68b-48a7-8ba5-7871bb362edb

	measure 'Camiones Operando Muro' = COALESCE(CALCULATE(DISTINCTCOUNT(Fact_HorasEquipo_Muro[Equipo]), Fact_HorasEquipo_Muro[Tipo Equipo] = "Truck", Fact_HorasEquipo_Muro[Horas Operativas] > 0), 0)
		formatString: 0
		lineageTag: 1db49707-2346-455e-bfab-47bd275e1459

	measure 'Camiones Muro' = [Camiones Operando Muro] & " / " & [Flota CAEX Muro Total]
		lineageTag: 1bee2b74-b6f5-45d5-bd1c-006b644be7df

	measure 'Cargadores Operando Muro' = COALESCE(CALCULATE(DISTINCTCOUNT(Fact_HorasEquipo_Muro[Equipo]), Fact_HorasEquipo_Muro[Tipo Equipo] = "Loader", Fact_HorasEquipo_Muro[Horas Operativas] > 0), 0)
		formatString: 0
		lineageTag: 4cfb0401-c740-4adc-909f-d99ad1c831ff

	measure 'Palas Operando Muro' = COALESCE(CALCULATE(DISTINCTCOUNT(Fact_HorasEquipo_Muro[Equipo]), Fact_HorasEquipo_Muro[Tipo Equipo] = "Shovel", Fact_HorasEquipo_Muro[Horas Operativas] > 0), 0)
		formatString: 0
		lineageTag: f21a15f8-a5c2-4116-9401-d00b5df7dfc9

	measure 'Cargadores Muro' = [Cargadores Operando Muro] & " / " & [Flota Cargador Muro Total]
		lineageTag: 773249b6-662b-432b-a834-e80f0855cadb

	measure 'Palas Muro' = [Palas Operando Muro] & " / " & [Flota Pala Muro Total]
		lineageTag: d3152f6e-1178-4d8c-8f96-eb335d4d820a

	measure 'Disponibilidad CAEX Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Disponibles]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Truck"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Nominales]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Truck"}),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 13295e46-f3a2-4955-9d3b-ba05f639091f

	measure 'UEBD CAEX Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Efectivas]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Truck"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Disponibles]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Truck"}),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 10de8e4b-55dc-4dda-93b7-2c77677f838b

	measure 'Rendimiento CAEX Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Movimiento Total]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Truck"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Efectivas]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Truck"}),
			    0
			)
		formatString: #,0.0
		lineageTag: ac6e3969-e07c-4788-8b5c-296f88780211

	measure 'Disponibilidad Pala Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Disponibles]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Nominales]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel"}),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: bb1619dd-87f1-4eaa-baef-767c4c57a950

	measure 'UEBD Pala Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Efectivas]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Disponibles]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel"}),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8bc67728-5f3a-44fa-b962-f62893d7820e

	measure 'Rendimiento Pala Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Tonelaje]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Efectivas]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel"}),
			    0
			)
		formatString: #,0.0
		lineageTag: 47c5e682-649f-4946-8974-2f647acf6e9b

	measure 'Disponibilidad Carguio Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Disponibles]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel", "Loader"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Nominales]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel", "Loader"}),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: e4af8e06-1c35-46b5-b18a-ad90a1d6d89d

	measure 'UEBD Carguio Muro' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Efectivas]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel", "Loader"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Disponibles]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel", "Loader"}),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: f2fa7406-8129-45cb-a0c6-e8463f2e0834

	measure 'Rendimiento Carguio Muro t/h' =
			DIVIDE(
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Tonelaje]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel", "Loader"}),
			    CALCULATE(SUM(Fact_HorasEquipo_Muro[Horas Efectivas]), Fact_HorasEquipo_Muro[Tipo Equipo] IN {"Shovel", "Loader"}),
			    0
			)
		formatString: #,0.0
		lineageTag: 1dedcc5a-30a3-4c7a-b1ad-040ef53622c1

	measure 'Material Muro' = SUM(Fact_HorasEquipo_Muro[Movimiento Total])
		formatString: #,0
		lineageTag: 9082bbdf-7bca-41b2-a6db-a93d003bd9bc

