	/// Posicion 1-24 en el dia operacional. En blanco cuando HoraTurno es nulo (hora no asignable al turno).
	column Orden_Hora_Dia =
			VAR HT = Fact_ChancadoOrigen_Hora[HoraTurno]
			RETURN
			    IF(NOT ISBLANK(HT) && HT >= 1 && HT <= 12, SWITCH(Fact_ChancadoOrigen_Hora[Turno], "A", HT, "B", HT + 12))
		isHidden
		formatString: 0
		lineageTag: 465f83c2-6d58-45b6-879b-1acb67dc81b1
		summarizeBy: none

	partition Fact_ChancadoOrigen_Hora = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "fact_chancado_origen_hora.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Hora", Int64.Type}, {"Origen", type text}, {"Tonelaje", type number}, {"Turno", type text}, {"Hora_Orden", Int64.Type}, {"HoraTurno", Int64.Type}}, "en-US"),
				    // Ventana de historia: solo las filas de los ultimos DiasHistoria dias respecto de FechaReferencia.
				    Ventana = Table.SelectRows(Tipos, each Date.From([Fecha]) >= Date.AddDays(FechaReferencia, -DiasHistoria))
				in
				    Ventana

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

