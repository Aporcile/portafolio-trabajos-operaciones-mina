table Fact_ChancadoOrigen_Hora
	lineageTag: 2c3a3852-8713-490a-9239-f88819159847

	measure Plan_Chancado_Dia = ```
			
			VAR FechaSel = [Fecha_Efectiva]
			RETURN
			    CALCULATE(
			        SUM(Plan_Semanal_Chancador[Plan Semanal]),
			        Plan_Semanal_Chancador[Fecha] = FechaSel
			    )
			
			```
		lineageTag: 1bf54cbe-c37c-48a6-80b5-003638c903fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Plan_Chancado_Hora =
			IF(
			    SELECTEDVALUE(Dim_Hora_Operacional[Es_Espacio]) = 1,
			    BLANK(),
			    DIVIDE([Plan_Chancado_Dia], 24)
			)
		lineageTag: e4135319-e447-48ac-b932-3eeaf685922e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Toneladas_Chancado_Hora = ```
			
			VAR FechaSel = [Fecha_Efectiva]
			VAR HT = SELECTEDVALUE(Fact_ChancadoOrigen_Hora[HoraTurno])
			RETURN
			    IF(
			        NOT ISBLANK(HT),
			        AVERAGEX(
			            VALUES(Fact_ChancadoOrigen_Hora[Turno]),
			            CALCULATE(
			                SUM(Fact_ChancadoOrigen_Hora[Tonelaje]),
			                Fact_ChancadoOrigen_Hora[Fecha] = FechaSel,
			                Fact_ChancadoOrigen_Hora[HoraTurno] = HT
			            )
			        ),
			        CALCULATE(SUM(Fact_ChancadoOrigen_Hora[Tonelaje]), Fact_ChancadoOrigen_Hora[Fecha] = FechaSel)
			    )
			
			```
		lineageTag: 79f45fe4-f8f4-45da-a0cf-3263bb815c86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

