	column Mes
		dataType: int64
		formatString: 0
		lineageTag: 7fc1dd4d-f55f-b53f-5276-65d4061f319b
		summarizeBy: none
		sourceColumn: Mes

	column NombreMes
		dataType: string
		lineageTag: 35be9942-14e7-7996-ed0d-95d3daf9d85e
		sourceColumn: NombreMes
		sortByColumn: Mes

	column Dia
		dataType: int64
		formatString: 0
		lineageTag: e2ee733b-db05-6399-161e-720352364146
		summarizeBy: none
		sourceColumn: Dia

	column DiaSemana
		dataType: string
		lineageTag: 9f8792c1-3351-69ce-492f-cbbd74522a2b
		sourceColumn: DiaSemana
