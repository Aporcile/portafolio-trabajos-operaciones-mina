	column Fecha
		dataType: dateTime
		isKey
		formatString: dd-MM-yyyy
		lineageTag: 0e24c539-8f00-77ce-0e55-adedb35bd3be
		sourceColumn: Fecha

		annotation UnderlyingDateTimeDataType = Date

	column Anio
		dataType: int64
		formatString: 0
		lineageTag: 537e861e-bbc8-a5cd-19fc-3f1105f27276
		summarizeBy: none
